<div class="content" id="user-locator-app">

    <el-form ref="form" :model="form" class="mt-20" label-width="120px">
        <span class="is-size-3 is-pulled-left">User Locator</span>
        <span class="is-size-3 is-link is-pulled-right">
            <el-form-item label="Advanced">
                <el-switch v-model="advanceMode"></el-switch>
            </el-form-item>
        </span>
        <div class="is-clearfix"></div>
        <el-form-item label="Name">
            <el-input v-model="form.name"></el-input>
        </el-form-item>
        <el-form-item label="活动区域" v-show="advanceMode">
            <el-select v-model="form.region" placeholder="请选择活动区域">
                <el-option label="区域一" value="shanghai"></el-option>
                <el-option label="区域二" value="beijing"></el-option>
            </el-select>
        </el-form-item>

        <el-form-item label="即时配送"  v-show="advanceMode">
            <el-switch v-model="form.delivery"></el-switch>
        </el-form-item>
        <el-form-item label="活动性质" v-show="advanceMode">
            <el-checkbox-group v-model="form.type">
                <el-checkbox label="美食/餐厅线上活动" name="type"></el-checkbox>
                <el-checkbox label="地推活动" name="type"></el-checkbox>
                <el-checkbox label="线下主题活动" name="type"></el-checkbox>
                <el-checkbox label="单纯品牌曝光" name="type"></el-checkbox>
            </el-checkbox-group>
        </el-form-item>
        <el-form-item label="特殊资源" v-show="advanceMode">
            <el-radio-group v-model="form.resource">
                <el-radio label="线上品牌商赞助"></el-radio>
                <el-radio label="线下场地免费"></el-radio>
            </el-radio-group>
        </el-form-item>

        <el-form-item v-show="advanceMode">
            <el-button type="primary" @click="onSubmit">
                Search
            </el-button>
            <el-button>Reset</el-button>
        </el-form-item>
    </el-form>
</div>