<div class="content" id="user-locator-app">
    <el-form ref="form" :model="form" class="mt-20" label-width="120px">
        <span class="is-size-3 is-pulled-left">User Locator</span>
        <span class="is-size-3 is-link is-pulled-right">
            <el-form-item label="Advanced">
                <el-switch v-model="advanceMode"></el-switch>
            </el-form-item>
        </span>
        <div class="is-clearfix"></div>
        <el-form-item label="Name">
            <el-input v-model="form.name" placeholder="The user's name ..."></el-input>
        </el-form-item>
        <el-form-item label="Dealerships" v-show="advanceMode">
            <el-select v-model="selectedDealer" filterable placeholder="Type or choose from the list" style="width: 500px;">
                <el-option
                        v-for="(item, idx) in dealers"
                        :key="idx"
                        :label="item.company_name"
                        :value="item.company_id">
                </el-option>
            </el-select>
        </el-form-item>

        <el-form-item label="Position" v-show="advanceMode">
            <el-checkbox-group v-model="form.positions">
                {% for role,label in roles %}
                <el-checkbox label="{{ label }}" name="type[]"></el-checkbox>
                {% endfor %}
            </el-checkbox-group>
        </el-form-item>

        <el-form-item v-show="advanceMode">
            <el-button type="primary" @click="onSubmit">
                Search
            </el-button>
            <el-button>Reset</el-button>
        </el-form-item>
    </el-form>
</div>