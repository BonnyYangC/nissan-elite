{% extends 'layout/backend.twig' %}
{% block content %}
    <div class="container">
        <div class="content mt-20">
            <div class="columns">
                <div class="column">
                    <h1>Incentives Management</h1>
                </div>
                <div class="column">
                    <a href="{{ url('/admin/incentive-new') }}" class="button is-pulled-right"><i class="fa fa-plus"></i>&nbsp;New Incentive</a>
                </div>
            </div>
            <table class="table">
                <thead>
                <tr>
                    <th>Title</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Image</th>
                    <th>Attachment</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% if count(upcoming)>0 %}
                <tr>
                    <td colspan="6"><h3>Upcoming</h3></td>
                </tr>
                {% for incentive in upcoming %}
                    <tr>
                        <td>
                            <p>
                                <b>{{ incentive.title }}</b>
                            </p>
                            <p>
                                {{ incentive.caption }}
                            </p>
                        </td>
                        <td>{{ incentive.start }}</td>
                        <td>{{ incentive.finish }}</td>
                        <td>
                            {% if incentive.image %}
                            <img width="120" class="thumbnail" src="{{ asset('/images/incentives/images/') }}{{ incentive.image }}" alt="">
                            {% endif %}
                        </td>
                        <td>
                            {% if incentive.pdf %}
                            <a href="{{ asset('/images/incentives/images/pdf/') }}{{ incentive.pdf }}" target="_blank">View PDF</a>
                            {% endif %}
                        </td>
                        <td>
                            {% set param = {'eid':incentive.id} %}
                            <a href="{{ url('/admin/incentive-edit',param) }}"
                               class="button is-small is-link">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a href="{{ url('/admin/incentive-delete',param) }}"
                               class="button is-small is-danger btn-need-confirm">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                {% endif %}
                <tr>
                    <td colspan="6"><h3 class="has-text-link">Current</h3></td>
                </tr>
                {% for incentive in current %}
                    <tr>
                        <td>
                            <p>
                                <b>{{ incentive.title }}</b>
                            </p>
                            <p>
                                {{ incentive.caption }}
                            </p>
                        </td>
                        <td>{{ incentive.start }}</td>
                        <td>{{ incentive.finish }}</td>
                        <td>
                            {% if incentive.image %}
                                <img width="120" class="thumbnail" src="{{ asset('/images/incentives/images/') }}{{ incentive.image }}" alt="">
                            {% endif %}
                        </td>
                        <td>
                            {% if incentive.pdf %}
                                <a href="{{ asset('/images/incentives/images/pdf/') }}{{ incentive.pdf }}" target="_blank">View PDF</a>
                            {% endif %}
                        </td>
                        <td>
                            {% set param = {'eid':incentive.id} %}
                            <a href="{{ url('/admin/incentive-edit',param) }}"
                               class="button is-small is-link">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a href="{{ url('/admin/incentive-delete',param) }}"
                               class="button is-small is-danger btn-need-confirm">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                <tr>
                    <td colspan="6"><h3 class="has-text-success">Just Finished</h3></td>
                </tr>
                {% for incentive in justFinished %}
                    <tr>
                        <td>
                            <p>
                                <b>{{ incentive.title }}</b>
                            </p>
                            <p>
                                {{ incentive.caption }}
                            </p>
                        </td>
                        <td>{{ incentive.start }}</td>
                        <td>{{ incentive.finish }}</td>
                        <td>
                            {% if incentive.image %}
                                <img width="120" class="thumbnail" src="{{ asset('/images/incentives/images/') }}{{ incentive.image }}" alt="">
                            {% endif %}
                        </td>
                        <td>
                            {% if incentive.pdf %}
                                <a href="{{ asset('/images/incentives/images/pdf/') }}{{ incentive.pdf }}" target="_blank">View PDF</a>
                            {% endif %}
                        </td>
                        <td>
                            {% set param = {'eid':incentive.id} %}
                            <a href="{{ url('/admin/incentive-edit',param) }}"
                               class="button is-small is-link">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a href="{{ url('/admin/incentive-delete',param) }}"
                               class="button is-small is-danger btn-need-confirm">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                <tr>
                    <td colspan="6"><h3 class="has-text-danger">Past</h3></td>
                </tr>
                {% for incentive in past %}
                    <tr>
                        <td>
                            <p>
                                <b>{{ incentive.title }}</b>
                            </p>
                            <p>
                                {{ incentive.caption }}
                            </p>
                        </td>
                        <td>{{ incentive.start }}</td>
                        <td>{{ incentive.finish }}</td>
                        <td>
                            {% if incentive.image %}
                                <img width="120" class="thumbnail" src="{{ asset('/images/incentives/images/') }}{{ incentive.image }}" alt="">
                            {% endif %}
                        </td>
                        <td>
                            {% if incentive.pdf %}
                                <a href="{{ asset('/images/incentives/images/pdf/') }}{{ incentive.pdf }}" target="_blank">View PDF</a>
                            {% endif %}
                        </td>
                        <td>
                            {% set param = {'eid':incentive.id} %}
                            <a href="{{ url('/admin/incentive-edit',param) }}"
                               class="button is-small is-link">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a href="{{ url('/admin/incentive-delete',param) }}"
                               class="button is-small is-danger btn-need-confirm">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}