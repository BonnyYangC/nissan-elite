{% extends 'layout/backend.twig' %}
{% block content %}
    <form action="{{ get_route('admin.usage') }}" method="post" class="form">

        <div class="container">
            <div class="content mt-20">
                <div class="columns">
                    <div class="column">
                        <h1>Page Usage</h1>
                    </div>
                    <div class="column">
                        <button type="submit" name="submit" class="button is-pulled-right" style="margin-right: 10px;" value="Export"><i class="fa fa-download"></i>&nbsp;Export All</button>
                        <button type="submit" name="submit" class="button is-pulled-right" style="margin-right: 10px;" value="Filter"><i class="fa fa-filter"></i>&nbsp;Filter</button>
                    </div>
                </div>

                <input type="hidden" name="event[id]" value="{{ event.id }}">
                <h2 class="m-4"> {{ event.title }}</h2>
                <hr>

                <div class="field is-horizontal">
                    <div class="field-label is-normal">
                        <label class="label">Start Date</label>
                    </div>
                    <div class="field-body">
                        <div class="field">
                            <div class="control">
                                <input class="input" type="date" name="datestart" placeholder="Start at" value="{{ datestart }}">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="field is-horizontal">
                    <div class="field-label is-normal">
                        <label class="label">End Date</label>
                    </div>
                    <div class="field-body">
                        <div class="field">
                            <div class="control">
                                <input class="input" type="date" name="dateend" placeholder="End at" value="{{ dateend }}">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="field is-horizontal">
                    <div class="field-label is-normal">
                        <label class="label">User</label>
                    </div>

                    <div class="field-body">
                        <div class="field">

                            <div class="control">
                                <div class="select is-fullwidth">
                                    <select name="user_selected">
                                        <option value="All Users">All Users</option>
                                        {% set last_reg = '' %}                                        
                                        {% for u in users %}

                                            {% if (last_reg != u.region) %}
                                                </optgroup>
                                                <optgroup label="{{u.region}} -------------------------------------------------------------------------">
                                                    <option value="All for {{u.region}}" {{ 'All for '~u.region == user_selected ? 'selected' : '' }}>All for {{u.region}} </option>                                                    
                                                    {{ 'All for '~u.region }} == {{ user_selected }}
                                                    
                                            {% endif %}

                                            {% if (last_com != u.company_name) %}
                                                </optgroup>
                                                <optgroup label="{{u.region}} - {{u.company_name}}">
                                                    <option value="All company {{u.company_id}}" {{ 'All company '~u.company_id == user_selected ? 'selected' : '' }} >{{u.region}} - &nbsp;(All for {{u.company_name}})</option>
                                                    {{'All company '~u.company_id }} == {{ user_selected }}

                                            {% endif %}
                                                    <option {{ u.user_id == user_selected ? 'selected' : '' }} value="{{u.user_id}}">{{u.region}} - <strong>{{ u.company_name }}</strong> - {{ u.firstname }} {{ u.lastname }}</option>                                        

                                            {% set last_reg = u.region %}
                                            {% set last_com = u.company_name %}
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="field is-horizontal">
                    <div class="field-label is-normal">
                        <label class="label">Page</label>
                    </div>

                    <div class="field-body">
                        <div class="field">

                            <div class="control">
                                <div class="select is-fullwidth">
                                    <select name="page_selected">
                                        <option value="" {{ event.region=='All'?'selected':null }}>All</option>
                                        {% for page_el in pages %}
                                            <option {{ (page_selected==page_el) ? 'selected' : '' }}>{{ page_el }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="field is-horizontal">
                    <div class="field-label is-normal">
                        <label class="label">Summarise by</label>
                    </div>

                    <div class="field-body">
                        <div class="field">

                            <div class="control">
                                <div class="select is-fullwidth">
                                    <select name="summarise_by" >
                                        <option value="">--</option>
                                        <option {{ summarise_by == 'Region'     ? 'selected' : '' }}>Region</option>
                                        <option {{ summarise_by == 'Dealership' ? 'selected' : '' }}>Dealership</option>
                                        <option {{ summarise_by == 'Position'   ? 'selected' : '' }}>Position</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>



                <br>
                <br>



                <table class="table">
                    <thead>
                    <tr>
                        {% for heading in report_headings %}
                            <th>
                                {{ heading }}
                            </th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in report %}
                        <tr>
                            {% for field in row %}    
                                <td>
                                    {{ field }}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </form>

{% endblock %}