{% extends 'layout/backend.twig' %}
{% block content %}
    <div class="container">
        <div class="content mt-20">
            <div class="columns">
                <div class="column">
                    <h1>Nissan Admin Users Management</h1>
                </div>
                <div class="column">
                    <a href="{{ get_route('admin.users.super.new') }}" class="button is-success is-pulled-right"><i class="fa fa-plus"></i>&nbsp;New Admin</a>
                </div>
            </div>
            <table class="table">
                <thead>
                <tr>
                    <th>Region</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Password</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <th>All Regions</th>
                        <td>{{ user.firstname }} {{ user.lastname }}</td>
                        <td><a href="mailto:{{ user.email }}">{{ user.email }}</a></td>
                        <td>{{ user.mobile }}</td>
                        <td>{{ user.password }}</td>
                        <td>
                            {% set param = {'uid':user.user_id} %}
                            <a href="{{ url('/admin/users-super-edit',param) }}" class="button is-small is-link">Edit</a>
                            <a href="{{ url('/admin/users-super-delete',param) }}" class="button is-small is-danger btn-need-confirm">Delete</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}