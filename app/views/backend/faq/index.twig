{% extends 'layout/backend.twig' %}
{% block content %}
    <div class="container">
        <div class="content mt-20">
            <div class="columns">
                <div class="column">
                    <h1>FAQ Content Management</h1>
                </div>
                <div class="column">
                    <a href="{{ url('/admin/faq-new') }}" class="button is-pulled-right"><i class="fa fa-plus"></i>&nbsp;New</a>
                </div>
            </div>
            <table class="table">
                <thead>
                <tr>
                    <th>Order</th>
                    <th>Content</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                {% for faq in faqs %}
                    <tr>
                        <th>{{ faq.sorting }}</th>
                        <td>
                            <p><b>{{ faq.question }}</b></p>
                        </td>
                        <td>{{ faq.status ? 'Published' : 'Draft' }}</td>
                        <td>
                            {% set param = {'eid':faq.id} %}
                            <a href="{{ url('/admin/faq-edit',param) }}"
                               class="button is-small is-link">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a href="{{ url('/admin/faq-delete',param) }}"
                               class="button is-small is-danger btn-need-confirm">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}