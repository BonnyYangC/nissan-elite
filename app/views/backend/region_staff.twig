{% extends 'layout/backend.twig' %}
{% block content %}
    <div class="container">
        <div class="content mt-20">
            <div class="columns">
                <div class="column">
                    <h1>Region Staff Management</h1>
                </div>
                <div class="column">
                </div>
            </div>
            <table class="table">
                <thead>
                <tr>
                    <th>Region</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Password</th>
                    <th>Position</th>
                    <th>Active</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <th>{{ user.alt_position }}</th>
                        <td>{{ user.firstname }} {{ user.lastname }}</td>
                        <td><a href="mailto:{{ user.email }}">{{ user.email }}</a></td>
                        <td>{{ user.mobile }}</td>
                        <td>{{ user.password }}</td>
                        <td>{{ user.position }}</td>
                        <td>
                        {% if user.active == 1 %}
                            <span class="has-text-success">Y</span>
                        {% else %}
                            <span class="has-text-danger">N</span>
                        {% endif %}
                        </td>
                        <td>
                            {% set param = {'uid':user.user_id} %}
                            <a href="{{ url('/admin/fake-region-staff',param) }}" target="_blank" title="Mock as this user"
                               class="button is-small is-link">M</a>
                            <a href="{{ url('/admin/region-staff-edit',param) }}" title="Edit" class="button is-small is-link">E</a>
                            <a href="{{ url('/admin/users-region-delete',param) }}" title="Delete this user" class="button is-small is-danger btn-need-confirm">D</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}