{% extends 'layout/backend.twig' %}
{% block content %}
    <div class="container">
        <div class="content mt-20">
            <div class="columns">
                <div class="column">
                    <h1>Calendar Management</h1>
                </div>
                <div class="column">
                    <a href="{{ url('/admin/calendar-new') }}" class="button is-pulled-right"><i class="fa fa-plus"></i>&nbsp;New Event</a>
                </div>
            </div>
            <table class="table">
                <thead>
                <tr>
                    <th>Title</th>
                    <th>Period</th>
                    <th>Region</th>
                    <th>Incentive/Description</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                {% for event in events %}
                    <tr>
                        <th>{{ event.title }}</th>
                        <td>{{ event.datestamp }}/{{ event.dateend }}</td>
                        <td>{{ event.region }}</td>
                        <td>
                            <p>{{ event.incentive_name }}</p>
                            <p>{{ event.description }}</p>
                        </td>
                        <td>
                            {% set param = {'eid':event.id} %}
                            <a href="{{ url('/admin/calendars-edit',param) }}"
                               class="button is-small is-link">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a href="{{ url('/admin/calendars-delete',param) }}"
                               class="button is-small is-danger btn-need-confirm">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}