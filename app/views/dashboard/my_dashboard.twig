{% extends 'layout/frontend.twig' %}
{% block content %}
<!-- {{ user.employee_code }} -->
<div class="container bg-white pl-25 pr-25">
    <div class="ac-tooltip">1000</div>
    <div class="row">
        <div class="col-md-9">
            <h1 class="page-header" >
                <span class='page-header-title'>Welcome {{ user.firstname }} - {{ currentRoleText }}</span>
            </h1>
        </div>
    </div>
    <!-- Projects Row -->
    <div class="row pb-20">
        <div class="col-md-9">
            <div class="table-responsive">
                {% set awart_unit = configuration('PROGRAM_AWARD_UNIT') %}
                {% set chartInitData = {'title': 'Monthly '~awart_unit,'el_id':'bar-chart'} %}
                {% include 'dashboard/widget_element/bar-chart.twig' with chartInitData %}  
                 <p align="center">Registration, Dealer Excellence and Incentive {{ configuration('PROGRAM_AWARD_UNIT')|lower }} are included in the above graph.</p>
            </div>
            <hr>
            <div class="row">
                <div class="col-md-12">
                    <h3>LEADER BOARD</h3>
                    {% include 'dashboard/widget_element/leader_board_table.twig' %}
                </div>
            </div>
            <hr>
            <div class="row">
                <div class="col-md-12">
                    <h3>Current Status Level</h3>
                    {% include 'dashboard/widget_element/current_status_level_chart.twig' %}
                </div>
            </div>
            <hr>

        </div>  
        <div class="col-md-3 pb-0">
            <h3>RANKINGS &amp; {{ configuration('PROGRAM_AWARD_UNIT')|raw }}</h3>
            {% include 'dashboard/widget_element/current_ranking_table.twig' %}
            {% include 'dashboard/widget_element/year_to_date_table.twig' %}
            {% include 'dashboard/widget_element/life_time_table.twig'  with {'link': url('/dashboard/Lifetime')} %}
            {% include 'dashboard/widget_element/dealer_excellence_table.twig' %}
            {% include 'dashboard/widget_element/are_you_registered_table.twig' %}
            {% include 'dashboard/widget_element/traing_or_track_table.twig' %}
            {% include 'dashboard/widget_element/have_you_met_criteria.twig' %}
            <!--{% include 'dashboard/widget_element/events_calendar.twig' %}-->
            {% include 'dashboard/widget_element/last_year_link.twig' %}

        </div>  
    </div>        
    <div class="row">
        <div class="col-md-12">
            <!---- Sales Percentage ---->
            <h3>
                {% if dashboardMenuOnly %}
                {% set matrics_url = url('/manager/fake-user/matrics?uid=') ~ user.user_id %}
                {% else %}
                {% set matrics_url = url('/dashboard/Metrics') %}
                {% endif %}
                {{ configuration('PROGRAM_AWARD_UNIT')|lower }} earned per Month 
                <a href="{{ matrics_url }} " class="btn btn-primary" style="background-color:#4169E1; color: #FFFFFF; margin:0 auto; font-weight: lighter; font-size:11px;">
                    VIEW METRICS PAGE HERE
                </a>
            </h3>

            <!-- points earned per month -->
            {% if userHasMultipleRoles %}
                {% include 'dashboard/widget_element/credits_earned/multiple_roles.twig' %}
            {% else %}
                {% include 'dashboard/widget_element/credits_earned/single_role.twig' %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
