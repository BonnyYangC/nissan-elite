{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container bg-white pl-25 pr-25">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="page-header">
                    <span class='page-header-title'>GUILD</span>
                </h1>
            </div>
        </div>
        <div class="row pb-20">
            <div class="col-md-9 mb-60">
                <div class="border12 center-block">
                    <img src="{{ asset('images/md_guild/The_Guild_logo.png') }}" class="img-responsive" alt="" />
                </div>

                <p>&nbsp;</p>
                <p>GUILD members are our most valued members of Nissan {{ configuration('PROGRAM_SHORT_NAME') }}!</p>
                <p>Induction to The GUILD is awarded on achievement of GOLD Loyalty Recognition level accumulating 325,000+ points through your achievements and Loyalty to the brand.</p>
                <p>To be invited to events you must maintain within each program year; GOLD Status or {{ configuration('PROGRAM_SHORT_NAME') }} Status Average. (lifetime credits/years of service) (refer to the member guide for full details).</p>
                <p>Our Platinum inductees are also recognised at these events when their achievements exceed 500,000 points showing continued loyalty to the Brand.</p>
                <p>To see where our GUILD members have celebrated and news on our next trip click <a href="{{ url('/dashboard/MDguild-events') }}" style="color: #c71444; font-weight : bold;">EVENTS</a> tab.</p>

                
            </div>

            <div class="col-lg-3 col-sm-12">
                <div class="row">
                    <a href="{{ url('/dashboard/MDguild-members') }}">
                        <button type="button" class="btn btn-default btn-lg btn-block">Guild Members</button>
                    </a>
                    <!--<a href="{{ url('/dashboard/MDguild-high-achievers') }}">
                        <button type="button" class="btn btn-default btn-lg btn-block">High Achievers</button>
                    </a>-->
                    <a href="{{ url('/dashboard/MDguild-events') }}">
                        <button type="button" class="btn btn-default btn-lg btn-block">Events</button>
                    </a>
                </div>
                <p>&nbsp; </p>
                <div class="row">
                    <iframe src="https://www.youtube.com/embed/KaBL4Y18oco" frameborder="0" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
{% endblock %}