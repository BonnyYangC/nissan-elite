{% extends 'layout/frontend.twig' %}
{% block content %}
    <style>
        .fa-print {
            float: right;
            margin-right: 20px;
            margin-top: -15px;
        }
        .modal-dialog {
            width: 900px;
        }
        td a {
            font-size: 12px;
        }

        #myPopup-Results h4 {
            font-size: 20px !important;
        }

        #myPopup-Results h4::before {
            content: 'YTD ';
        }
    </style>
    <div class="container bg-white" id="member-ranking-app">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="page-header">
                    <span class='page-header-title'>MEMBER RANKINGS</span>
                </h1>
            </div>
        </div>
        <div class="col-md-12" style="margin-bottom: 140px;">
            <div class="col-md-12">
                <div class="row mt-40">
                    <div class="panel-group" id="accordion">
                        <div class="col-md-6">
                            {% for group in userGroups1 %}
                                <div class="panel panel-default">
                                    <a data-toggle="collapse" data-parent="#accordion" href="#collapse{{ group.name }}" style="{{ group.style }}">
                                        <div class="panel-heading squarebutton {{ group.className }}">{{ group.name }}</div>
                                    </a>
                                    <div id="collapse{{ group.name }}" class="panel-collapse collapse">
                                        <div class="panel-body panel-square" >
                                            {% for member in group.members %}
                                            <div class="col-md-{{ 12/count(group.members) }}">
                                                <h4 class="white">{{ member.name }}</h4>
                                                <table class="table">
                                                {% if group.statusAndHighAchiever %}
                                                    {% for sh in awardType %}
                                                        <tr>
                                                            <td><a href="#myPopup" v-on:click.prevent='{{ member.className }}_{{ sh }} =! {{ member.className }}_{{ sh }}'>{{ sh|upper }} AWARD</a></td>
                                                        </tr>

                                                        {% for action in rankingForAll %}
                                                        <tr v-if="{{ member.className }}_{{ sh }}">
                                                            <td> - <a href="#myPopup" v-on:click.prevent='handleClick("{{ member.role }}","{{ action }}","{{ sh }}")'>{{ action }}</a></td>
                                                        </tr>
                                                        {% endfor %}
                                                    {% endfor %}
                                                {% elseif group.forAll %}
                                                    {% for action in rankingForAll %}
                                                    <tr>
                                                        <td><a href="#myPopup" v-on:click.prevent='handleClick("{{ member.role }}","{{ action }}")'>{{ action }}</a></td>
                                                    </tr>
                                                    {% endfor %}
                                                {% else %}
                                                    {% for action in rankingForNationalOnly %}
                                                        <tr>
                                                            <td><a href="#myPopup" v-on:click.prevent='handleClick("{{ member.role }}","{{ action }}")'>{{ action }}</a></td>
                                                        </tr>
                                                    {% endfor %}
                                                {% endif %}
                                                </table>
                                            </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="col-md-6">
                            {% for group in userGroups2 %}
                                <div class="panel panel-default">
                                    <a data-toggle="collapse" data-parent="#accordion" href="#collapse{{ group.name }}" style="{{ group.style }}">
                                        <div class="panel-heading squarebutton {{ group.className }}">{{ group.name }}</div>
                                    </a>
                                    <div id="collapse{{ group.name }}" class="panel-collapse collapse">
                                        <div class="panel-body panel-square" >
                                            {% for member in group.members %}
                                                <div class="col-md-{{ 12/count(group.members) }}">
                                                    <h4 class="white">{{ member.name }}</h4>
                                                    <table class="table">
                                                        {% if group.forAll %}
                                                            {% for action in rankingForAll %}
                                                                <tr>
                                                                    <td><a href="#myPopup" v-on:click.prevent='handleClick("{{ member.role }}","{{ action }}")'>{{ action }}</a></td>
                                                                </tr>
                                                            {% endfor %}
                                                        {% else %}
                                                            {% for action in rankingForNationalOnly %}
                                                                <tr>
                                                                    <td><a href="#myPopup" v-on:click.prevent='handleClick("{{ member.role }}","{{ action }}")'>{{ action }}</a></td>
                                                                </tr>
                                                            {% endfor %}
                                                        {% endif %}
                                                    </table>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {% for group in userGroups3 %}
                    <div class="panel panel-default admin-full-wide" >
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapse{{ group.name }}" style="{{ group.style }}">
                            <div class="panel-heading squarebutton {{ group.className }}">{{ group.name }}</div>
                        </a>
                        <div id="collapse{{ group.name }}" class="panel-collapse collapse">
                            <div class="panel-body panel-square" >
                                {% for member in group.members %}
                                <div class="col-md-{{ 12/count(group.members) }}">
                                    <h4 class="white">{{ member.name }}</h4>
                                    <table class="table">
                                    {% if group.forAll %}
                                        {% for action in rankingForAll %}
                                        <tr>
                                            <td><a href="#myPopup" v-on:click.prevent='handleClick("{{ member.role }}","{{ action }}")'>{{ action }}</a></td>
                                        </tr>
                                        {% endfor %}
                                    {% else %}
                                        {% for action in rankingForNationalOnly %}
                                            <tr>
                                                <td><a href="#myPopup" v-on:click.prevent='handleClick("{{ member.role }}","{{ action }}")'>{{ action }}</a></td>
                                            </tr>
                                        {% endfor %}
                                    {% endif %}
                                    </table>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}

                <div class="">
                    <el-dialog title="" :visible.sync="dialogTableVisible" width="70%">
                        <div class="rankings-modal-title-wrap">
                            <h4 class="modal-title">${ tableTitle } ${ modalTitle } </h4>
                            <a class="print-icon" href="#" v-on:click="printThis()"><i class="fa fa-print" aria-hidden="true" title="Print"></i></a>
                        </div>
                        <div class="rankings-table-title-wrap">
                            <h3 class="text-center text-capitalize">${ modalTitle }</h3>
                        </div>
                        <div class="table-responsive" v-for="(block, idx) in blocks" :key="idx">
                            <h3>${ block.category }</h3>
                            <el-table :data="block.rows" stripe :row-class-name="tableRowClassName">
                                <el-table-column property="r" label="Rank" width="80"></el-table-column>
                                <!--<el-table-column v-if="type == 'status'" property="r" label="Rank" width="80"></el-table-column>
                                <el-table-column v-if="type == 'platinum'" property="rp" label="Rank" width="80"></el-table-column>-->
                                <el-table-column class-name="bold-text sales-name" width="220" property="n" label="Name"></el-table-column>
                                <el-table-column property="d" width="270" label="Dealer"></el-table-column>
                                <el-table-column v-if="type == 'status'" property="c" label="Points"></el-table-column>
                                <el-table-column v-if="type == 'platinum'" property="c" label="Points Platinum"></el-table-column>
                                <!--<el-table-column v-if="type == 'platinum'" property="cp" label="Points Platinum"></el-table-column>-->
                                <el-table-column property="s" label="State"></el-table-column>
                                <el-table-column align="center" class-name="reg" property="re" label="Registered"></el-table-column>
                                <el-table-column align="center" class-name="elite_dealer" property="ed" label="ELITE Dealer"></el-table-column>
                            </el-table>
                        </div>
                    </el-dialog>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

