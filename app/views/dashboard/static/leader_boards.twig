                                                    <td><a data-toggle="modal" href="#myPopup" onclick="showresults('M','C','N');">Current National</a></td>
                                                </tr>
                                                <tr>
                                                    <td><a data-toggle="modal" href="#myPopup" onclick="showresults('M','C','R');">Current Regional</a></td>
