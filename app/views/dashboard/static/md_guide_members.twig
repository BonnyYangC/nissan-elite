{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container bg-md-guide" id="md-guide-member-app">
        <div class="container-layer">
            <img class="md-guild-banner" src="{{ asset('/images/md-guild-banner.png') }}" alt="MD Guild">
            <hr class="md-guild-hr">
            <div class="row">
                <div class="col-lg-9 col-sm-12">
                    <h2>HONOUR BOARD</h2>
                    <p>
                        Below is a list of our current Managing Director’s Guild Members. Platinum status is awarded for reaching over 500,000 lifetime credits and Gold status achieved by reaching over 325,000 credits.
                    </p>
                    <table class="md-guild-table md-guild-table--platinum md-guild-table--emphasize-left md-guild-table--full-width">
                        <thead>
                        <tr>
                            <th colspan="2">
                                PLATINUM
                            </th>
                        </tr>
                        </thead>
                        <tbody data-data-file="/data/md-guild/guild-members-platinum.json">
                            <tr v-for="(row, key, index) in platinum" :key="index">
                                <td>${ row[0] }</td>
                                <td>${ row[1] }</td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="md-guild-table md-guild-table--gold md-guild-table--emphasize-left md-guild-table--full-width">
                        <thead>
                        <tr>
                            <th colspan="2">
                                GOLD
                            </th>
                        </tr>
                        </thead>
                        <tbody data-data-file="/data/md-guild/guild-members-gold.json">
                        <!-- To modify the contents of this table, use the data file above-->
                        <tr v-for="(row, key, index) in gold" :key="index">
                            <td>${ row[0] }</td>
                            <td>${ row[1] }</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-lg-3 col-sm-12">
                    <a href="{{ asset('/dashboard/MDguild') }}">
                        <button type="button" class="btn btn-default btn-lg btn-block">Back</button>
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}