{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container bg-white pl-25 pr-25">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="page-header">
                        <span class='page-header-title'>Frequently Asked Questions</span>
                </h1>
            </div>
        </div>
        <div class="row mb-320" style="padding-bottom:20px">
            <div class="col-md-12">
                <div class="row">
                    <div class="panel-group" id="accordion">
                        <div class="panel panel-default">
                            <div class="panel-heading"> <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne"> <strong>How and when do I have to register?</strong></a></div>
                            <div id="collapseOne" class="panel-collapse collapse in">
                                <div class="panel-body">
                                    <p>Members must register once every program year. {{ configuration('YEAR') }} program starts 1 Apr {{ configuration('YEAR') }} – 31 March {{ configuration('YEAR')+1 }} at <a href="{{ configuration('eventRegisterUrl') }}">{{ configuration('eventRegisterUrl') }}</a>.</p>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-default">
                            <div class="panel-heading"> <a data-toggle="collapse" data-parent="#accordion" href="#collapseTwo"><strong>How do I join the {{configuration('PROGRAM_NAME')}}?</strong></a> </div>
                            <div id="collapseTwo" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <p>Refer to “Are you eligible?” on the login page.  You must be enrolled on the Nissan Dealer User Management portal and hold a 5-digit registration number and be in an {{configuration('PROGRAM_NAME')}} eligible role.  You will be automatically rolled over into {{configuration('PROGRAM_NAME')}}, receiving a Welcome Pack with your details, 
                                        and notification for your compulsory registration at <a href="{{ configuration('eventRegisterUrl') }}">www.nissan-events.com.au/nissanelite/reg</a>. 
                                        On completion you will receive an e-Mail confirmation and only then be eligible to earn Awards/Rewards within {{configuration('PROGRAM_NAME')}}.</p>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-default">
                            <div class="panel-heading"> <a data-toggle="collapse" data-parent="#accordion" href="#collapseThree"> <strong>Am I eligible to participate in Sprint Incentives?</strong> </a> </div>
                            <div id="collapseThree" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <p>Yes, providing the criteria is applicable to your role and all {{ configuration('PROGRAM_SHORT_NAME') }} &amp; Sprint Incentive T&amp;Cs are met.  {{configuration('PROGRAM_NAME')}} registration is compulsory for all incentives.</p>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-default">
                            <div class="panel-heading"> <a data-toggle="collapse" data-parent="#accordion" href="#collapseFour"> <strong>Am I eligible in {{configuration('PROGRAM_NAME')}} if I am enrolled on the Nissan Dealer User Management portal?</strong> </a> </div>
                            <div id="collapseFour" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <p>If you are enrolled on the Nissan Dealer User Management portal in an eligible {{ configuration('PROGRAM_SHORT_NAME') }} role you are a member of {{ configuration('PROGRAM_SHORT_NAME') }} but NOT an eligible member until you have registered in the current program period. Every member must register once in every {{configuration('PROGRAM_NAME')}} period (current program 1 Apr – 31 March) to be eligible.</p>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-default">
                            <div class="panel-heading"> <a data-toggle="collapse" data-parent="#accordion" href="#collapseFive"> <strong>What is the {{configuration('PROGRAM_NAME')}} period?</strong> </a> </div>
                            <div id="collapseFive" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <p>Annual Program from - 1 Apr – 31 March </p>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-default">
                            <div class="panel-heading"> <a data-toggle="collapse" data-parent="#accordion" href="#collapseSix"> <strong>Where can I find my metrics and criteria for {{configuration('PROGRAM_NAME')}}?</strong> </a> </div>
                            <div id="collapseSix" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <p>Go to the Members Guide tab and click your department/role tab. You will find all information about {{configuration('PROGRAM_NAME')}} here.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}