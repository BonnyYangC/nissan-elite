{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container">
        <!--1-->
        <div class="row">
            <div class="col-lg-12">
                <img class="img-responsive center-block program_ele" alt="" src="{{ asset('images/nissan_elite.gif') }}">
            </div>
        </div>
        <!--2-->
        <div class="row">
            <div class="col-lg-12">
                <div class=" center-block program_ele program_ele_1">
                    <h1 class="text-center text-capitalize">Welcome to our
                        <br>NEW {{configuration('PROGRAM_NAME')}}</h1>

                    <div style="text-align: center;">&nbsp;</div>

                    <h3 class="text-center text-capitalize">Our Annual Nissan Program will:</h3>

                    <p class="text-center">• recognize your high performance and loyalty to the Nissan brand<br>
                        • promote incentives with great rewards and prizes for you<br>
                        • recognize entire dealership team in achieving {{ configuration('PROGRAM_DEALERSHIP') }} award</p>

                    <p class="text-center">Your contribution counts each and every day and you could be recognized and rewarded as a Nissan {{ configuration('PROGRAM_I_ELITE') }}.</p>
                </div>
            </div>
        </div>
        <!--3-->
        <div class="row">
            <div class="col-lg-12">
                <div class=" center-block program_ele program_ele_2">
                    <p class="text-center">The Elite program is designed with your individual performance and reward in mind. As a benefit, it also helps contribute to your {{ configuration('PROGRAM_DEALERSHIP') }}’s ranking points and Dealer Principal’s Elite status points.<br>
                        <br>
                        In turn, your {{ configuration('PROGRAM_DEALERSHIP') }}’s total score earns you booster points to help increase your own {{ configuration('PROGRAM_I_ELITE') }} status and rewards. That’s why, the {{ configuration('PROGRAM_DEALERSHIP') }} program will now be visible and communicated to all staff members, while your {{ configuration('PROGRAM_I_ELITE') }} status and points will be visible to the whole team too! You can shine bright in front of your peers!</p>

                    <div style="text-align: center;">&nbsp;</div>

                    <h3 class="text-center text-capitalize">Team and individual mutual benefits:</h3>
                    &nbsp;
                    <img class="img-responsive" src="{{ asset('images/mutual_benefits.png') }}" width="100%"></td>
                </div>
            </div>
        </div>
        <!--4-->
        <div class="row">
            <div class="col-lg-12">
                <div class=" center-block program_ele program_ele_3">
                    <h3 class="text-center text-capitalize">Who is in the {{ configuration('PROGRAM_SHORT_NAME') }} program and how do you earn points:</h3>
                    &nbsp;
                    <div class="program_ele_border">
                        <img class="img-responsive center-block" src="{{ asset('images/loader/ELITE-dealership-white.png') }}" width="75%">
                        <p class="text-center"><br>
                            <strong>Whole of Dealership</strong>
                        </p>

                        <p class="text-center">Recognized using the {{ configuration('PROGRAM_DEALERSHIP')|upper }} program and GLOBAL AWARD</p>


                    </div>
                    &nbsp;
                    <div class="program_ele_border">

                        <div style="float:left; width:60%">
                            <img src="{{ asset('images/loader/ELITE-individual-white.png') }}" class="img-responsive center-block">
                            <p class="text-center"><br>
                                Dealer Principal<br>
                                Sales Manager<br>
                                Retail Sales Consultant<br>
                                Fleet Sales Executive<br>
                                Stock Controller<br>
                                Financial Controller<br>
                                F&amp;I Manager<br>
                                Service Manager<br>
                                Service Advisor<br>
                                Parts Manager<br>
                                Parts Sales Rep<br>
                                &nbsp;</p>

                            <p class="text-left">
                                <strong>Dealer Principal:</strong>
                            </p>

                            <ul>
                                <li>Status based on {{ configuration('PROGRAM_DEALERSHIP') }} ranking</li>
                                <li>Special Recognition</li>
                            </ul>

                            <p class="text-left">
                                <strong>Staff Roles:</strong>
                            </p>

                            <ul>
                                <li>Status based on Metrics</li>
                                <li>Gift Cards</li>
                                <li>Incentives</li>
                                <li>Trophies</li>
                                <li>Certificates &amp; Lapel pins</li>
                                <li>Trips &amp; Experiences</li>
                                <li>The Guild Invitation</li>
                            </ul>
                        </div>
                        <div style="float:right; margin-top:60px;">
                            <img src="{{ asset('images/nissan_elite_model.png') }}" class="pull-right img-responsive" width="120">
                        </div>
                        <div style="height:1px; margin-top:­1px;clear: both;overflow:hidden;"></div>
                    </div>

                </div>
            </div>
        </div>

        <!--5-->
        <div class="row">
            <div class="col-lg-12">
                <div class=" center-block program_ele program_ele_4">
                    <h3 class="text-center text-capitalize">Recognition in front of your peers:</h3>

                    <p class="text-center" style="font-size: 16px;">Whole Team, Dealer Principals and High Achieving Individuals</p>
                    <img src="{{ asset('images/nissan_elite_small.png') }}" class="img-responsive center-block" width="80%">
                    <p class="text-center">All {{ configuration('PROGRAM_I_ELITE') }} status recognition awards including the {{ configuration('PROGRAM_DEALERSHIP') }} and Nissan Global Awards will be presented at your state Product Challenge event.</p>

                </div>
            </div>
        </div>
    </div>
    <script>
    (function(){
        document.body.style.backgroundImage = "url('/images/about_program_bg.png')";
    })();
    </script>
    <style>
        .bg-image {
            background-image: url('/images/about_program_bg.png');
            background-size: 100% 100%;
        }
    
        .program_ele {
            width: 55%;
            margin-top: 10px;
            margin-bottom: 15px;
            float:none;
        }
        @media only screen and (max-width: 480px){
            .program_ele {
                width: 95%;
            }
        }
        /* Small devices (landscape phones, 375px and up)*/
        @media(min-width: 375px) {
            .program_ele {
                width: 95%;
            }
        }
        /* Small devices (landscape phones, 576px and up)*/
        @media(min-width: 576px) {
            .program_ele {
                width: 95%;
            }
        }
        /* Medium devices (tablets, 768px and up)*/
        @media(min-width: 768px) {
            .program_ele {
                width: 600px;
            }
        }
        /* Large devices (desktops, 992px and up)*/
        @media(min-width: 992px) {
            .program_ele {
                width: 600px;
            }
        }
        /* Extra large devices (large desktops, 1200px and up)*/
        @media(min-width: 1200px) {
            .program_ele {
                width: 600px;
            }
        }
    
        .program_ele_1 {
            background: linear-gradient(to bottom right, #8c0022, #c40030, #8c0022, #c40030, #8c0022);
            background-color: #c40030;
            padding: 20px;
        }
        .program_ele_1 h1 {
            color: #FFFFFF;
            font-size: 26px;
            font-style: normal;
            line-height: 125%;
            font-weight: 600;
            letter-spacing: 0.2px;
        }
        .program_ele_1 h3 {
            color: #FFFFFF;
            font-size: 20px;
            font-style: normal;
            line-height: 150%;
            letter-spacing: 1px;
        }
        .program_ele_1 p {
            color: #FFFFFF;
            font-size: 14px;
            line-height: 150%;
            margin: 10px 0;
        }
        .program_ele_2 {
            background: linear-gradient(to bottom right, #aaaaaa, #ffffff, #bbbbbb, #ffffff);
            background-color: #e3e3e3;
            padding: 30px;
        }
        .program_ele_2 p {
            color: #000000;
            font-size: 14px;
            line-height: 150%;
            margin: 10px 0;
        }
    
        .program_ele_2 h3 {
            color: #C40030;
            display: block;
            margin: 0;
            padding: 0;
            font-size: 20px;
            font-style: normal;
            line-height: 150%;
            letter-spacing: normal;
        }
    
        .program_ele_3 {
            background: linear-gradient(to bottom right, #111111, #353535, #111111, #353535);
            background-color: #222222;
            padding: 30px;
        }
        .program_ele_3 h3 {
            color: #c40030;
            font-weight: 400;
            display: block;
            margin: 0;
            padding: 0;
        
            font-size: 18px;
            font-style: normal;
            line-height: 150%;
            letter-spacing: normal;
        
        }
        .program_ele_3 p {
            color: #FFFFFF;
            font-size: 14px;
            line-height: 150%;
            margin: 10px 0;
        }
        .program_ele_border {
            border: 1px #555555 solid;
            padding: 30px;
        }
        .program_ele_border p {
            color: #FFFFFF;
            margin: 10px 0;
            padding: 0;
            font-size: 14px;
            line-height: 150%;
        }
        .program_ele_border ul {
            padding-left: 20px;
            text-align: left;
            color: #ffffff;
        }
    
        .program_ele_4 {
            background: linear-gradient(to bottom right, #111111, #222222, #111111, #222222);
            background-color: #353535;
            padding: 30px;
        }
        .program_ele_4 p {
            color: #FFFFFF;
            margin: 10px 0;
            padding: 0;
            font-size: 14px;
            line-height: 150%;
        }
        .program_ele_4 h3 {
            color: #ffffff;
            letter-spacing: 1px;
            display: block;
            margin: 0;
            padding: 0;
            font-size: 20px;
            font-style: normal;
            font-weight: normal;
            line-height: 150%;
        }
    </style>
{% endblock %}
