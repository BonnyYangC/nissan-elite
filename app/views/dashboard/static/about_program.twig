{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container bg-image">
        <!--1-->
        <div class="row" >
            <div class="col-lg-12">
                <img class="img-responsive center-block program_ele" alt="" src="{{ asset('images/nissan_elite_gif.gif') }}">
            </div>
        </div>
        <!--2-->
        <div class="row">
            <div class="col-lg-12">
                <div class=" center-block program_ele program_ele_1">
                    <h1 class="text-center text-capitalize">About the
                        <br>Nissan Elite Program.</h1>

                    <div style="text-align: center;">&nbsp;</div>

                    <h3 class="text-center text-capitalize">Our Annual Nissan Program will:</h3>

                    <p class="text-center">• recognize your high performance and loyalty to the Nissan brand<br>
                        • promote incentives with great rewards and prizes for you<br>
                        • recognize entire dealership team in achieving ELITE Dealership award</p>

                    <p class="text-center">Your contribution counts each and every day and you could be recognized and rewarded as a Nissan ELITE Individual.</p>
                </div>
            </div>
        </div>
        <!--3-->
        <div class="row">
            <div class="col-lg-12">
                <div class=" center-block program_ele program_ele_2">
                    <p class="text-center">The Elite program is designed with your individual performance and reward in mind. As a benefit, it also helps contribute to your ELITE Dealership’s ranking points and Dealer Principal’s Elite status points.<br>
                        <br>
                        In turn, your ELITE Dealership’s total score earns you booster points to help increase your own ELITE Individual status and rewards. That’s why, the ELITE Dealership program will now be visible and communicated to all staff members, while your ELITE Individual status and points will be visible to the whole team too! You can shine bright in front of your peers!</p>

                    <div style="text-align: center;">&nbsp;</div>

                    <h3 class="text-center text-capitalize">Team and individual mutual benefits:</h3>
                    &nbsp;
                    <img class="img-responsive" src="{{ asset('images/mutual_benefits.png') }}" width="100%"></td>
            </div>
        </div>
    </div>
    <!--4-->
    <div class="row">
        <div class="col-lg-12">
            <div class=" center-block program_ele program_ele_3">
                <h3 class="text-center text-capitalize">Who is in the Elite program and how do you earn points:</h3>
                &nbsp;
                <div class="program_ele_border">
                    <img class="img-responsive center-block" src="{{ asset('images/elite_dealership.png') }}" width="75%">
                    <p class="text-center"><br>
                        <strong>Whole of Dealership</strong>
                    </p>

                    <p class="text-center">Recognized using the ELITE DEALERSHIP program and GLOBAL AWARD</p>


                </div>
                &nbsp;
                <div class="program_ele_border">
                    
                    <div style="float:left;">
                    <img src="{{ asset('images/elite_individual.png') }}" class="img-responsive center-block">
                        <p class="text-center"><br>
                            Dealer Principal<br>
                            Sales Manager<br>
                            Retail Sales Consultant<br>
                            Fleet Sales Executive<br>
                            Stock Controller<br>
                            Financial Controller<br>
                            F&amp;I Manager<br>
                            Service Manager<br>
                            Service Advisor<br>
                            Parts Manager<br>
                            Parts Sales Rep<br>
                            &nbsp;</p>

                        <p class="text-left">
                            <strong>Dealer Principal:</strong>
                        </p>

                        <ul>
                            <li>Status based on ELITE Dealership ranking</li>
                            <li>Special Recognition</li>
                        </ul>

                        <p class="text-left">
                            <strong>Staff Roles:</strong>
                        </p>

                        <ul>
                            <li>Status based on Metrics</li>
                            <li>Gift Cards</li>
                            <li>Incentives</li>
                            <li>Trophies</li>
                            <li>Certificates &amp; Lapel pins</li>
                            <li>Trips &amp; Experiences</li>
                            <li>The Guild Invitation</li>
                        </ul>
                    </div>
                    <div style="float:right; margin-top:60px;">
                        <img src="{{ asset('images/nissan_elite_model.png') }}" class="pull-right img-responsive" width="120">
                    </div>
                    <div style="height:1px; margin-top:­1px;clear: both;overflow:hidden;"></div>
                </div>

            </div>
        </div>
    </div>

        <!--5-->
        <div class="row">
                <div class="col-lg-12">
                    <div class=" center-block program_ele program_ele_4">
                            <h3 class="text-center text-capitalize">Recognition in front of your peers:</h3>

                            <p class="text-center" style="font-size: 16px;">Whole Team, Dealer Principals and High Achieving Individuals</p>
                            <img src="{{ asset('images/nissan_elite_small.png') }}" class="img-responsive center-block" width="80%">
                            <p class="text-center">All ELITE individual status recognition awards including the ELITE Dealership and Nissan Global Awards will be presented at your state Product Challenge event.</p>

                </div>
            </div>
        </div>
</div>
