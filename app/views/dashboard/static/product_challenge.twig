{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-lg-offset-3" style="background-color: #000000; color:#ffffff;padding-left:0; padding-right:0;">
                <img class="img-responsive center-block" alt="" src="{{ asset('images/pc/cover.jpg') }}">
                <div style="margin: 45px; font-size: 14px;">

                    <h1 class="font-weight-bold" style="color: #c40030;">{{ configuration('PROGRAM_SHORT_NAME') }} Product Challenge 2019 Final Results</h1>

                    <p class="pc_graph">Over the course of July and August, Nissan conducted seven Product Challenge events across the country. 
                        Dealership teams came together for a night to recognize individual and dealership achievements and of course test their Nissan product knowledge.  
                        The events were very well attended, with many new attendance records broken under the new {{ configuration('PROGRAM_SHORT_NAME') }} program.  
                        </p>

                    <p class="pc_graph">Each state’s event winning team was a contender for the {{ configuration('PROGRAM_SHORT_NAME') }} Product Challenge National Masters.  
                        The final results leader board is as follows, and Nissan would like to congratulate our National Masters Champion:</p>

                    <h1 class="font-weight-bold" style="color: #c40030;">Ferntree Gully Nissan</h1>
                </div>
                <img class="img-responsive center-block" alt="" src="{{ asset('images/pc/Ferntree_Gully_Nissan.jpg') }}">
                <div style="margin: 45px;">
                    <table class="table text-center">
                        <thead>
                            <tr class="font-weight-bold" style="background: #c40030">
                                <td class="r-border">National Masters Place</td>
                                <td class="r-border">Winning State Event Dealership</td>
                                <td>Event Location</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="r-border">1st</td>
                                <td class="font-weight-bold r-border">Ferntree Gully Nissan</td>
                                <td>Melbourne</td>
                            </tr>
                            <tr>
                                <td class="r-border">2nd</td>
                                <td class="font-weight-bold r-border">Clarkson Nissan</td>
                                <td>Western & Central - WA</td>
                            </tr>
                            <tr>
                                <td class="r-border">3rd</td>
                                <td class="font-weight-bold r-border">von Bibra Gold Coast Nissan</td>
                                <td>Brisbane</td>
                            </tr>
                            <tr>
                                <td class="r-border">3rd</td>
                                <td class="font-weight-bold r-border">Pennant Hills Nissan</td>
                                <td>Sydney</td>
                            </tr>
                            <tr>
                                <td class="r-border">5th</td>
                                <td class="font-weight-bold r-border">Main North Nissan</td>
                                <td>Western & Central - SA</td>
                            </tr>
                            <tr>
                                <td class="r-border">5th</td>
                                <td class="font-weight-bold r-border">Parry NQ Nissan</td>
                                <td>Townsville</td>
                            </tr>
                            <tr>
                                <td class="r-border">7th</td>
                                <td class="font-weight-bold r-border">Motors Nissan Launceston</td>
                                <td>Launceston</td>
                            </tr>
                        </tbody>
                    </table>

                    <p>&nbsp;</p>
                    <p class="font-weight-bold pc_graph">Congratulations also goes to our Runner up teams who were not far behind….</p>
                    <table class="table text-center">
                        <tr>
                            <td class="font-weight-bold r-border">Brighton Nissan</td> 					
                            <td>Melbourne</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold r-border">Rockingham Nissan</td> 				
                            <td>Western & Central - WA </td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold r-border">Ipswich Nissan</td> 					
                            <td>Brisbane</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold r-border">Brookvale Nissan</td> 					
                            <td>Sydney</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold r-border">Jarrett Nissan</td> 					
                            <td>Western & Central - SA</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold r-border">North Jacklin Nissan</td> 				
                            <td>Townsville</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold r-border">Hobart Nissan</td>					
                            <td>Launceston</td>
                        </tr>
                    </table>

                    <p>&nbsp;</p>
                    <p class="pc_graph">The {{ configuration('PROGRAM_SHORT_NAME') }} program is designed to reward high achievement and loyalty to the Nissan brand and will continue to bring you engaging and relevant incentives and reward programs. 
                        Get your staff involved and make sure you and your staff register in the  {{ configuration('PROGRAM_SHORT_NAME') }} program.
                    </p>

                    <p>&nbsp;</p>
                    <img class="img-responsive center-block" alt="" src="{{ asset('images/pc/footer_image.jpg') }}">
                    <p>&nbsp;</p>
                    <p>&nbsp;</p>
                </div>
            </div>
        </div>
    </div>
    <style>
        table .r-border {
            border-right: 1px solid #ffffff;
        }

        table tr:nth-of-type(even) {
            background-color: #222222;
        }

        table tr:nth-of-type(odd) {
            background-color: #666666;
        }

        .table>tbody>tr>td {
            vertical-align: middle;
        }

        .pc_graph {
            margin: 20px 0;
        }
    </style>
{% endblock %}