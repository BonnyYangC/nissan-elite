{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container bg-white pl-25 pr-25">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="page-header">
                        <span class='page-header-title'>PRODUCT CHALLENGE</span>
                </h1>
            </div>
        </div>
        <div class="row pb-20">
            <div class="col-md-9 mb-60">
                <div class="border12 center-block">
                    <img src="{{ asset('images/Product_Challenge_Cover.jpg') }}" class="img-responsive" alt="" />
                </div>

                <h3 class="champion_head">2019 PRODUCT CHALLENGE EVENTS</h3>

                <p>Once again, our Product Challenge events around the country have been a great success with attendee numbers increasing every year!  
                    Dealers from all over Australia showing they have been hitting the Nissan Academy to improve their knowledge of the Nissan brand, 
                    with all striving to achieve Regional status and reach the top accolade of <b>National Masters Champion</b>.  
                    Throughout the 7 events Clarkson Nissan held the top spot only to be pipped at the post in Melbourne at the final event.  
                    An excellent achievement Clarkson, however our winners for 2019 goes to…</p>

                <h3 class="champion_head">National Masters Champion 2019</h3>
                <p class="champion_para">
                    <b>FERNTREE GULLY NISSAN</b>
                </p>
                <p><b>Congratulations</b> to the team at Ferntree Gully, your near perfect score of 98 will be one for the record books and a real challenge for 2020!  Enjoy your well-earned reward of an extra $2000 to celebrate your win.</p>
                
                <p>&nbsp;</p>
                <h3 class="champion_head">Our Region Winners and Runners up are as follows:</h3>
                <table width=100%>
                    <tr>
                        <td colspan="2" class="tb-champion_area">Adelaide</td>
                    </tr>
                    <tr>
                        <td>Winner – <b>Main North Nissan</b></td>
                        <td>Runner up - <b>Jarrett Nissan</b></td>
                    </tr>
                    <tr>
                        <td colspan="2" class="tb-champion_area">Perth </td>
                    </tr>
                    <tr>
                        <td>Winner – <b>Clarkson Nissan</b></td>
                        <td>Runner up - <b>Rockingham Nissan</b></td>
                    </tr>
                    <tr>
                        <td colspan="2" class="tb-champion_area">Brisbane</td>
                    </tr>
                    <tr>
                        <td>Winner – <b>von Bibra Gold Coast Nissan</b></td>
                        <td>Runner up – <b>Ipswich Nissan</b></td>
                    </tr>
                    <tr>
                        <td colspan="2" class="tb-champion_area">Townsville</td>
                    </tr>
                    <tr>
                        <td>Winner - <b>Parry Nissan</b></td>
                        <td>Runner up - <b>North Jacklin Nissan</b></td>
                    </tr>
                    <tr>
                        <td colspan="2" class="tb-champion_area">Sydney</td>
                    </tr>
                    <tr>
                        <td>Winner – <b>Pennant Hills Nissan</b></td>
                        <td>Runner up – <b>Brookvale Nissan</b></td>
                    </tr>
                    <tr>
                        <td colspan="2" class="tb-champion_area">Launceston</td>
                    </tr>
                    <tr>
                        <td>Winner – <b>Motors Nissan Launceston</b></td>
                        <td>Runner up – <b>Hobart Nissan</b></td>
                    </tr>
                    <tr>
                        <td colspan="2" class="tb-champion_area">Melbourne</td>
                    </tr>
                    <tr>
                        <td>Winner – <b>Ferntree Gully Nissan</b></td>
                        <td>Runner up – <b>Brighton Nissan</b></td>
                    </tr>
                </table>
            </div>


            <!--<div class="col-md-3">
                <a href="{{ url('/dashboard/ProductChallengeWinners') }}"><button type="button" class="btn btn-default btn-lg btn-block">Winners</button></a>
                <a href="{{ url('/dashboard/ProductChallengeCurrentEvent') }}"><button type="button" class="btn btn-default btn-lg btn-block">Current Event</button></a>
                <img style="margin: 0 auto; margin-top: 25px;" class="img-responsive" src="{{ asset('images/PRODUCT_CHALLENGE_16.jpg') }}" width="80%" alt="">
            </div>-->
        </div>
    </div>
    <style>
        .tb-champion_area {
            color : #c71444;
        }
        .champion_head {
            color : #000000;
            font-weight: bold;
        }
        .champion_para {
            text-align: center;
            color:#c71444;
            font-size: 22px;
        }
    </style>
{% endblock %}