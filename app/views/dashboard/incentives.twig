{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container bg-white">
        <div class="row" id="Current">
            <div class="col-lg-12">
                <h1 class="page-header">INCENTIVES</h1>
            </div>
        </div>
        <div class="row">
            <div class="col-md-9">
                <h3>CURRENT</h3>
                <div class="row">
                    <div class="fotorama foto-slider-wrap" data-click="true" data-autoplay="true" data-width="100%" data-ratio="840/598" data-nav="thumbs" data-thumbwidth="84" data-thumbheight="60" data-allowfullscreen="true">
                        {% for slide in incentives %}
                        <div data-img="{{ asset('/images/incentives/images/') }}{{ slide.image }}">
                            <a href="{{ asset('/images/incentives/images/pdf/') }}{{ slide.pdf }}" target="_blank"></a>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Start Sidebar -->
            <div class="col-md-3">
                <a href="#Current">
                    <button type="button" class="btn btn-primary btn-lg btn-block">Current</button>
                </a>
                <a href="#Finished">
                    <button type="button" class="btn btn-default btn-lg btn-block">Just Finished</button>
                </a>
                <a href="#Past">
                    <button type="button" class="btn btn-default btn-lg btn-block">Past</button>
                </a>
                <div class="table-responsive">
                    <table class="table centre-text">
                        <tr class="nissangray-back">
                            <td colspan="2">Are you registered?</td>
                        </tr>
                        <tr class="nissangray-light-back">
                            <td>
                                <span class="rank">
                                    <a href="#" style="color:#FFFFFF; text-decoration:none;" title="You are eligible for the AC{{ env('YEAR') }} Program">
                                        {% if user.registered %}
                                            <span class="tw txt-red">&#10004</span>
                                        {% else %}
                                            X
                                        {% endif %}
                                    </a>
                                </span>
                                {% if user.registered %}
                                    <p class="tw">250 Credits Applied</p>
                                {% else %}
                                <a href="http://www.nissan-events.com.au/ac{{ env('YEAR') }}/reg" target="_blank">
                                    <button style="background-color:#c40030; width:100%; margin:0 auto; font-size:11px;" type="button" class="btn btn-primary btn-block">Register Now</button>
                                </a>
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        {# Finished #}
        <div class="row pb-20">
            <div class="col-md-3"></div>
            <div class="row" id="Finished"></div>
            <hr>
            <h3 class="pl-25">Just Finished</h3>
            <br>
            {% for row in incentivesFinished %}
                <div class="col-md-12">
                    {% for item in row %}
                        <div class="col-md-4 col-xs-12">
                            <a href="{{ asset('/images/incentives/images/pdf/') }}{{ item.pdf }}" target="_blank">
                                <img class="img-responsive" src="{{ asset('/images/incentives/images/') }}{{ item.image }}" alt="{{ item.title }}">
                            </a>
                            <p>{{ good_date(item.start) }} to {{ good_date(item.finish) }}<br>{{ item.title }}<br></p><br>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
        {# Past #}
        <div class="row pb-20">
            <div class="col-md-3"></div>
            <div class="row" id="Past"></div>
            <hr>
            <h3 class="pl-25">Past</h3>
            <br>

            {% for row in incentivesPast %}
            <div class="col-md-12">
                    {% for item in row %}
                    <div class="col-md-4 col-xs-12">
                        <a href="{{ asset('/images/incentives/images/pdf/') }}{{ item.pdf }}" target="_blank">
                            <img class="img-responsive" src="{{ asset('/images/incentives/images/') }}{{ item.image }}" alt="{{ item.title }}">
                        </a>
                        <p>{{ good_date(item.start) }} to {{ good_date(item.finish) }}<br>{{ item.title }}<br></p><br>
                    </div>
                    {% endfor %}
            </div>
            {% endfor %}

        </div>
    </div>
{% endblock %}