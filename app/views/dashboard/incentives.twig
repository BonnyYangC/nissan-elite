{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container bg-white">
        <div class="row" id="Current">
            <div class="col-lg-12">
                <h1 class="page-header">INCENTIVES</h1>
            </div>
        </div>
        <div class="row">
            <div class="col-md-9">
                <h3>{{ status }}</h3>
                <div class="row">
                    <div class="col-md-12" id="slider">
                        <div class="col-md-12" id="carousel-bounding-box">
                            <div id="myCarousel" class="carousel slide" data-ride="carousel" data-interval="3000">
                                <!-- main slider carousel items -->
                                <div class="carousel-inner">
                                    {{ current|raw }}
                                </div>
                                <a class="carousel-control left" href="#myCarousel"
                                                                              data-slide="prev">‹</a>

                                <a class="carousel-control right" href="#myCarousel" data-slide="next">›</a>
                            </div>
                        </div>

                    </div>
                </div>
                <!--/main slider carousel-->
                <br>

                <!-- thumb navigation carousel -->
                <div class="col-md-12 hidden-sm hidden-xs" id="slider-thumbs">

                    <!-- thumb navigation carousel items -->
                    <ul class="list-inline">
                        {{ thumb|raw }}
                    </ul>

                </div>


            </div>

            <!-- Start Sidebar -->
            <div class="col-md-3">
                <a href="#Current">
                    <button type="button" class="btn btn-primary btn-lg btn-block">Current</button>
                </a>
                <a href="#Finished">
                    <button type="button" class="btn btn-default btn-lg btn-block">Just Finished</button>
                </a>
                <a href="#Past">
                    <button type="button" class="btn btn-default btn-lg btn-block">Past</button>
                </a>
                <div class="table-responsive">
                    <table class="table centre-text">
                        <tr class="nissangray-back">
                            <td colspan="2">Are you registered?</td>
                        </tr>
                        <tr class="nissangray-light-back">
                            <td>
                                <span class="rank">
                                    <a href="#" style="color:#FFFFFF; text-decoration:none;" title="You are eligible for the AC2017 Program">
                                        {% if registered %}
                                            &#10004
                                        {% else %}
                                            X
                                        {% endif %}
                                    </a>
                                </span>
                                {% if registered == false %}
                                <a href="http://www.nissan-events.com.au/ac2017/reg" target="_blank">
                                    <button style="background-color:#c40030; width:100%; margin:0 auto; font-size:11px;" type="button" class="btn btn-primary btn-block">Register Now</button>
                                </a>
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>



        <!-- Projects Row -->
        <div class="row" style="padding-bottom:20px">
            <div class="col-md-3" style="padding-bottom:0px;"></div>
            <div class="row" id="Finished"></div>
            <hr>
            <h3>Just Finished</h3>
            <br>
            <div class="col-md-11"> {{ finished|raw }}</div>
        </div>
        <!-- /.row -->

        <!-- Projects Row -->
        <div class="row" style="padding-bottom:20px">
            <div class="col-md-3" style="padding-bottom:0px;"></div>
            <div class="row" id="Past"></div>
            <hr>
            <h3>Past</h3>
            <br>
            <div class="col-md-11"> {{ past|raw }}</div>
        </div>
    </div>
{% endblock %}