{% extends 'dashboard/metrics.twig' %}
{% block content_metrics %}
    <script>
        var yAxis = "{{ configuration('PROGRAM_AWARD_UNIT')}}";
        var CHART_DATA = [
            {//1. Dealer Stock Cover
                el: 'chart-cover-result',
                max: 425,
                length: 5,
                step: 85,
                colors: ['#999999'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.STOCK_COVER)|raw }}
            },
            {//2. OW DATA ENTRY COMPLIANCE
                el: 'chart-ow',
                max: 275,
                length: 11,
                step: 25,
                colors: ['#c40030'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.OW)|raw }}
            },
            {//3. Dealer Retail Forecast
                el: 'chart-retail',
                max: 150,
                length: 3,
                step: 50,
                colors: ['#999999'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.RETAIL)|raw }}
            },
            {//4. Matched OW Compliance
                el: 'chart-matched',
                max: 310,
                length: 5,
                step: 62,
                colors: ['#c40030'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.MATCHED)|raw }}
            },
            {//5. DAVO Orders Limit % Acceptance
                el: 'chart-davo',
                max: 575,
                length: 5,
                step: 115,
                colors: ['#999999'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.DAVO)|raw }}
            },
            {//6. Registration v Retails Compliance
                el: 'chart-regvret',
                max: 360,
                length: 6,
                step: 60,
                colors: ['#c40030'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.REGVRET)|raw }}
            },
            {
                el: 'chart-training',
                max: 1000,
                length: 10,
                step: 100,
                colors: ['#111111','#c40030','#3273dc'],
                pilot: ['Month', 'Online', 'Pathway','Competency'],
                isStacked: true,
                dataSource: {{ json_encode(metrics.TRAINING)|raw }}
            }
        ];
    </script>

    <div class="row pb-20">
        <div class="col-md-12 col-sm-12">
            <div class="row graph-back-top">
                <div class="col-md-7" >
                    <div class="table-responsive">
                        <h3>1. Dealer Stock Cover</h3>
                        <div id="chart-cover-result" class="metrics-chart-wrap"></div>
                        <table class="table table-condensed metrics-table-wrap">
                            {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                            <tr>
                                <td class="nissangray-light-back">RESULT</td>
                                {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.STOCK_COVER_RESULTS } %}
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="col-md-5">
                    <h3>DEALER STOCK COVER (DAYS) GUIDE</h3>
                    <table class="table small-table">
                        <tr class="table-top-row">
                            <td>Stock Controller </td>
                            <td align="center">As per policy</td>
                        </tr>
                        <tr class="active">
                            <td>Category A &amp; B</td>
                            <td align="center">425</td>
                        </tr>
                        <tr class="active">
                            <td>Category C</td>
                            <td align="center">425</td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row graph-back">
                <div class="col-md-7">
                    <h3>2. OW DATA ENTRY COMPLIANCE</h3>
                    <div class="table-responsive">
                        <div id="chart-ow" class="metrics-chart-wrap"></div>
                        <table class="table table-condensed metrics-table-wrap">
                            {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                            <tr>
                                <td class="nissangray-light-back">RESULT</td>
                                {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.OW_RESULTS } %}
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="col-md-5">
                    <h3>OW DATA ENTRY COMPLIANCE GUIDE</h3>
                    <table class="table small-table">
                        <tr class="table-top-row">
                            <td>Stock Controller </td>
                            <td align="center">≤ 1 Missed Day</td>
                            <td align="center">2-3 Missed Days</td>
                        </tr>
                        <tr class="active">
                            <td>Category A &amp; B</td>
                            <td align="center">275</td>
                            <td align="center">100</td>
                        </tr>
                        <tr class="active">
                            <td>Category C</td>
                            <td align="center">275</td>
                            <td align="center">100</td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row graph-back">
                <div class="col-md-7">
                    <h3>3. Dealer Retail Forecast </h3>
                    <div class="table-responsive">
                        <div id="chart-retail" class="metrics-chart-wrap"></div>
                        <table class="table table-condensed metrics-table-wrap">
                            {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                            <tr>
                                <td class="nissangray-light-back">RESULT</td>
                                {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.RETAIL_RESULTS } %}
                            </tr>
                        </table>
                    </div>
                    <br>
                </div>
                <div class="col-md-5">
                    <h3>Dealer Retail Forecast GUIDE</h3>
                    <table class="table small-table">
                        <tr class="table-top-row">
                            <td>Stock Controller </td>
                            <td align="center">YES</td>
                        </tr>
                        <tr class="active">
                            <td>Category A &amp; B</td>
                            <td align="center">150</td>
                        </tr>
                        <tr class="active">
                            <td>Category C</td>
                            <td align="center">150</td>
                        </tr>
                    </table>
                    <p><em>Entered 2<sup>nd</sup> Monday of month in NISCOM</em></p>
                </div>
            </div>
            <div class="row graph-back">
                <div class="col-md-7">
                    <h3>4. Matched OW Compliance</h3>
                    <div class="table-responsive">
                        <div id="chart-matched" class="metrics-chart-wrap"></div>
                        <table class="table table-condensed metrics-table-wrap">
                            {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                            <tr>
                                <td class="nissangray-light-back">RESULT</td>
                                {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.MATCHED_RESULTS } %}
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="col-md-5">
                    <h3>Matched Ow Compliance GUIDE</h3>
                    <table class="table small-table">
                        <tr class="table-top-row">
                            <td nowrap>Stock Controller </td>
                            <td align="center">0 or 1 unit Variation</td>
                            <td align="center">2 unit Variation</td>
                            <td align="center">3 unit Variation</td>
                        </tr>
                        <tr class="active">
                            <td nowrap>Category A &amp; B</td>
                            <td align="center">310</td>
                            <td align="center">105</td>
                            <td align="center">105</td>
                        </tr>
                        <tr class="active">
                            <td nowrap>Category C</td>
                            <td align="center">310</td>
                            <td align="center">105</td>
                            <td align="center"></td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row graph-back">
                <div class="col-md-7">
                    <h3>5. DAVO Orders - Limit % Acceptance</h3>
                    <div class="table-responsive">
                        <div id="chart-davo" class="metrics-chart-wrap"></div>
                        <table class="table table-condensed metrics-table-wrap">
                            {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                            <tr>
                                <td class="nissangray-light-back">RESULT</td>
                                {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.DAVO_RESULTS } %}
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="col-md-5">
                    <h3>Davo Orders - Limit % acceptance GUIDE</h3>
                    <table class="table small-table">
                        <tr class="table-top-row">
                            <td>Stock Controller </td>
                            <td align="center">≥60%</td>
                            <td align="center">≥80%</td>
                        </tr>
                        <tr class="active">
                            <td>Category A &amp; B</td>
                            <td align="center">275</td>
                            <td align="center">575</td>
                        </tr>
                        <tr class="active">
                            <td>Category C</td>
                            <td align="center">275</td>
                            <td align="center">475</td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row graph-back">
                <div class="col-md-7">
                    <h3>6. Registration v Retails Compliance</h3>
                    <div class="table-responsive">
                        <div id="chart-regvret" class="metrics-chart-wrap"></div>
                        <table class="table table-condensed metrics-table-wrap">
                            {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                            <tr>
                                <td class="nissangray-light-back">RESULT</td>
                                {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.REGVRET_RESULTS } %}
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="col-md-5">
                    <h3>Registration v Retails Compliance GUIDE</h3>
                    <table class="table small-table">
                        <tr class="table-top-row">
                            <td align="center">≥90%</td>
                        </tr>
                        <tr class="active">
                            <td align="center">360</td>
                        </tr>
                        <tr class="active">
                            <td align="center">360</td>
                        </tr>
                    </table>
                    <p>
                        <em>All Sales Types registered in same month as retailed</em>
                    </p>
                </div>
            </div>
            <div class="row graph-back">
                <div class="col-md-7">
                    <h3>7. TRAINING</h3>
                    <div class="table-responsive">
                        <div id="chart-training" class="metrics-chart-wrap">
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <h3>Training Guide</h3>
                    <table class="table small-table" >
                        <tr class="table-top-row">
                            <td>Competency Modules</td>
                            <td>Points Yearly</td>
                        </tr>
                        <tr class="active">
                            <td>Stock Controller Pathway (O)</td>
                            <td>450</td>
                        </tr>
                        <tr class="active">
                            <td>Dealer Forward Order System (DAVO)</td>
                            <td>500</td>
                        </tr>
                    </table>
                    <p>
                        <em>Refer to the <a href="{{ url('dashboard/MembersGuide') }}">{{ configuration('PROGRAM_SHORT_NAME_WITH_YEAR') }} Member Guide</a> for full details.</em>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}