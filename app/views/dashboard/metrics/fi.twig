{% extends 'layout/frontend.twig' %}
{% block content %}
    <script>
        var CHART_DATA = [
            {
                el: 'chart-nfsa',
                max: 2000,
                length: 8,
                step: 250,
                colors: ['#999999'],
                dataSource: {{ json_encode(metrics.NFSA)|raw }}
            },
            {
                el: 'chart-mvi-vpi-pkg',
                max: 800,
                length: 8,
                step: 100,
                colors: ['#999999', '#555555' ,'#111111'],
                pilot: ['Month', 'MVI', 'Package'],
                dataSource: {{ json_encode(metrics.INSURANCE)|raw }}
            },
            {
                el: 'chart-emw',
                max: 2000,
                length: 8,
                step: 250,
                colors: ['#555555','#c40030'],
                pilot: ['Month','Genuine'],
                dataSource: {{ json_encode(metrics.EMW)|raw }}
            },
            {
                el: 'chart-penetration',
                max: 1000,
                length: 4,
                step: 250,
                colors: ['#c40030'],
                pilot: ['Month','Credits'],
                dataSource: {{ json_encode(metrics.PENETRATION)|raw }}
            },
            {
                el: 'chart-follow-up',
                max: 500,
                length: 5,
                step: 100,
                colors: ['#555555'],
                pilot: ['Month','Credits'],
                dataSource: {{ json_encode(metrics.FOLLOW_UP)|raw }}
            },
            {
                el: 'chart-retention',
                max: 200,
                length: 10,
                step: 20,
                colors: ['#111111'],
                dataSource: {{ json_encode(metrics.RETENTION)|raw }}
            },
        ];
    </script>
    <div class="container bg-white">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="page-header">MY Metrics - <em>Finance &amp; Insurance</em></h1>
            </div>
        </div>
        <div class="row pb-20">
            <div class="col-md-12 col-sm-12">
                <div class="row graph-back">
                    <div class="col-md-7" >
                        <div class="table-responsive">
                            <h3>1. NFSA Contracts</h3>
                            <div id="chart-nfsa" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">RESULT</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.NFSA_RESULTS } %}
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <h3>NFSA Contracts GUIDE</h3>
                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td>F&amp;I Manager </td>
                                <td align="center">NFSA Finance Contract</td>
                            </tr>
                            <tr>
                                <td>Category A, B, C</td>
                                <td align="center">40</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="row graph-back">
                    <div class="col-md-7">
                        <h3>2. Loyalty & Retention Bonus</h3>
                        <div class="table-responsive">
                            <div id="chart-retention" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">RESULT</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.RETENTION_RESULTS } %}
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <h3>Loyalty & Retention Bonus Guide</h3>
                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td nowrap>F&amp;I Manager </td>
                                <td align="center">Loyalty & Retention Bonus</td>
                            </tr>
                            <tr>
                                <td nowrap>Category A, B, C</td>
                                <td align="center">10</td>
                            </tr>
                        </table>
                    </div>

                </div>

                <div class="row graph-back">
                    <div class="col-md-7">
                        <h3>3. Insurance – MVI &amp; MVI/NFSA pkg</h3>
                        <div class="table-responsive">
                            <div id="chart-mvi-vpi-pkg" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">MVI</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.INSURANCE_MVI_RESULTS } %}
                                </tr>
                                <tr>
                                    <td class="nissangray-light-back">Package</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.INSURANCE_PKG_RESULTS } %}
                                </tr>
                            </table>

                        </div>
                    </div>

                    <div class="col-md-5">
                        <h3>Insurance Guide</h3>
                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td nowrap>F&amp;I Manager </td>
                                <td align="center">MVI Motor Vehicle Insurance</td>
                                <td align="center">MVI &amp; Insurance</td>
                            </tr>
                            <tr>
                                <td nowrap>Category A, B, C</td>
                                <td align="center">40</td>
                                <td align="center">10</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="row graph-back">
                    <div class="col-md-7">
                        <h3>4. EMW Genuine</h3>
                        <div class="table-responsive">
                            <div id="chart-emw" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">Genuine</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.EMW_RESULTS } %}
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <h3>EMW Genuine Guide</h3>
                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td nowrap>F&amp;I Manager</td>
                                <td align="center">EMW Sale Genuine (NAPS)</td>
                            </tr>
                            <tr>
                                <td>Category A, B, C</td>
                                <td align="center">40</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="row graph-back">
                    <div class="col-md-7">
                        <h3>4. Dealer Sales Penetration</h3>
                        <div class="table-responsive">
                            <div id="chart-penetration" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">RESULT</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.PENETRATION_RESULT } %}
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <h3>Dealer Sales Penetration Guide</h3>
                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td>F&amp;I Manager</td>
                                <td align="center">30.0% - 44.9%</td>
                                <td align="center">45% - 59.9%</td>
                                <td align="center">60% - 74.9%</td>
                                <td align="center">75% or more</td>
                            </tr>
                            <tr>
                                <td>Category A, B, C</td>
                                <td align="center">250</td>
                                <td align="center">500</td>
                                <td align="center">750</td>
                                <td align="center">1000</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="row graph-back">
                    <div class="col-md-7">
                        <h3>5. CE - F&I Satisfaction - Single Mth</h3>
                        <div class="table-responsive">
                            <div id="chart-follow-up" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">RESULT</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.FOLLOW_UP_RESULTS } %}
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <h3>CE - F&I Satisfaction - Single Mth Guide</h3>
                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td>F&amp;I Manager</td>
                                <td align="center">86.0%</td>
                                <td align="center">86.1 - 89.9%</td>
                                <td align="center">90% or greater</td>
                            </tr>
                            <tr>
                                <td>Category A, B, C</td>
                                <td align="center">100</td>
                                <td align="center">300</td>
                                <td align="center">500</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}