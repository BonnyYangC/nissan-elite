{% extends 'dashboard/metrics.twig' %}
{% block content_metrics %}
    <script>
        {#var NEW_VEHICLE_SALES = [{{ metrics.NEW_VEHICLE_SALES|raw }}];#}
        {#var RECOMMENDATIONS = [{{ metrics.RECOMMENDATIONS|raw }}];#}
        {#var FOLLOW_UP = [{{ metrics.FOLLOW_UP|raw }}];#}
        {#var MIDMTH_RETAIL = [{{ metrics.MIDMTH_RETAIL|raw }}];#}
        {#var APNUR = [{{ metrics.APNUR|raw }}];#}
        {#var TRAINING = [{{ metrics.TRAINING|raw }}];#}
        var yAxis = "{{ configuration('PROGRAM_AWARD_UNIT')}}";
        var CHART_DATA = [
            {//1. MATCHED OW
                el: 'chart-matched-ow',
                max: 310,
                length: 5,
                step: 62,
                colors: ['#c40030'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.MATCHED_OW)|raw }}
            },
            {//2. NEW VEHICLE SALES
                el: 'chart-new-vehicle',
                max: 3000,
                length: 6,
                step: 500,
                colors: ['#999999'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.NEW_VEHICLE_SALES)|raw }}
            },
            {//3. Sales overall satisfaction NPS 3 month rolling score
                el: 'chart-sos',
                max: 800,
                length: 5,
                step: 200,
                colors: ['#999999', '#555555' ,'#c40030' ,'#c40030'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.JS_SOS)|raw }}
            },
            {//4. Kept informed of delivery NPS 6 month rolling score - Target 88
                el: 'chart-kid',
                max: 350,
                length: 7,
                step: 50,
                colors: ['#555555'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.JS_KID)|raw }}
            },
            {//5. DEALER RETAIL FORECAST
                el: 'chart-retail',
                max: 100,
                length: 4,
                step: 25,
                colors: ['#c40030'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.JS_RETAIL)|raw }}
            },
            {//6. APNUR PERFORMANCE v TARGET - NAVARA/XTRAIL/QASHQAI
                el: 'chart-apnur',
                max: 275,
                length: 11,
                step: 25,
                colors: ['#111111', '#c40030' ,'#3273dc'],
                isStacked: false,
                pilot: ['Month','NAVARA','XTRAIL','QASHQAI'],
                dataSource: {{ json_encode(metrics.APNUR)|raw }}
            },
            {//7. TRAINING
                el: 'chart-training',
                pilot: ['Month',  'Online', 'Pathway','Competency','Bonus'],
                max: 3000,
                length: 6,
                step: 500,
                colors: ['#111111', '#c40030' ,'#555555','#3273dc','#999999'],
                isStacked: true,
                dataSource: {{ json_encode(metrics.TRAINING)|raw }}
            }
        ];
    </script>

