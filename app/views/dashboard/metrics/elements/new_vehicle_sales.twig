<script>var NEW_VEHICLE_SALES = {{ metrics.JS_newVehicleSales|raw }};</script>
<div class="row graph-back-top pl-10">
    <div class="col-md-7" >
        <div class="table-responsive">
            <h3>{{ index }}. NEW VEHICLE SALES</h3>
            <div id="chart_div2" style="min-width: 600px; min-height: 500px;"></div>
            <table class="table table-condensed" style="width: 593px;" >
                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                <tr>
                    <td class="nissangray-light-back">RESULT</td>
                    {% for idx,sale in metrics.salesResult %}
