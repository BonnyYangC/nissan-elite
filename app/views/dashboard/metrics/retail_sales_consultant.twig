            },
            { //3. Kept informed of delivery NPS 3 month rolling score - Target 88
                el: 'chart-kept-informed',
                max: 305,
                length: 6,
                step: 61,
                colors: ['#999999'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.JS_keptInformedDelivery)|raw }}
            },
            { //4. Satisfaction with follow up NPS 6 month rolling score - Target 93
                el: 'chart-followup',
                max: 175,
                length: 7,
                step: 25,
                colors: ['#999999'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.JS_followUpSatisfaction)|raw }}
            },
            { //5. training
                el: 'chart-training',
                max: 3000,
                length: 6,
                step: 500,
                colors: ['#111111' ,'#c40030','#3273dc'],
                pilot: ['Month', 'Online' ,'Pathway','Competency'],
                isStacked: true,
                dataSource: {{ json_encode(metrics.JS_training)|raw }}
            }
        ];
    </script>

