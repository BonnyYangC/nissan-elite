            { //1. new vehicle sales
                el: 'chart-vehicle-sales',
                max: 5000,
                length: 10,
                step: 500,
                colors: ['#999999'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.JS_newVehicleSales)|raw }}
            },
            { //2. Salesperson Satisfaction NPS 6 month Rolling Score
                el: 'chart-salesperson-satisfaction',
                max: 5000,
                length: 10,
                step: 500,
                colors: ['#999999'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.JS_salespersonSatisfaction)|raw }}
            },
            { //3. Kept informed of delivery NPS 3 month rolling score - Target 88
                el: 'chart-kept-informed',
                max: 275,
                length: 25,
                step: 25,
                colors: ['#999999'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.JS_keptInformedDelivery)|raw }}
            },
            { //4. Satisfaction with follow up NPS 6 month rolling score - Target 93
                el: 'chart-followup',
                max: 100,
                length: 10,
                step: 20,
                colors: ['#999999'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.JS_followUpSatisfaction)|raw }}
            },
            { //5. training
                el: 'chart-training',
                max: 3000,
                length: 12,
                step: 250,
                colors: ['#111111' ,'#c40030','#3273dc'],
                pilot: ['Month', 'Online' ,'Pathway','Competency'],
                isStacked: true,
                dataSource: {{ json_encode(metrics.JS_training)|raw }}
            }
        ];
    </script>

