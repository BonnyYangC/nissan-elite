{% extends 'layout/frontend.twig' %}
{% block content %}
    <script>
        var CHART_DATA = [
            {
                el: 'chart-followup',
                max: 60,
                length: 6,
                step: 10,
                colors: ['#999999'],
                dataSource: {{ json_encode(metrics.JS_followUpCredits)|raw }}
            },
            {
                el: 'chart-vehicle-sales',
                max: 5000,
                length: 10,
                step: 500,
                colors: ['#999999'],
                dataSource: {{ json_encode(metrics.JS_newVehicleSales)|raw }}
            },
            {
                el: 'chart-recommendation',
                max: 5000,
                length: 10,
                step: 500,
                colors: ['#999999'],
                dataSource: {{ json_encode(metrics.JS_reCommendation)|raw }}
            },
            {
                el: 'chart-training',
                max: 3000,
                length: 12,
                step: 250,
                colors: ['#111111' ,'#c40030','#3273dc'],
                pilot: ['Month', 'Online' ,'Pathway','Competency'],
                isStacked: true,
                dataSource: {{ json_encode(metrics.JS_training)|raw }}
            }
        ];
    </script>
    <div class="container bg-white pl-25">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="page-header">
                    <a class="print-icon" href="#" onclick="window.print();return false;">
                        <i class="fa fa-print" aria-hidden="true" title="Print"></i>
                    </a>
                    <br>
                    MY Metrics - <em>Sales Consultant</em><!-- retail_sales_consultant -->
                </h1>
            </div>
        </div>
        <div class="row pb-20 pl-10">
            <div class="col-md-12 col-sm-12  pb-20 pl-10">

                <div class="row graph-back-top pl-10">
                    <div class="col-md-7" >
                        <div class="table-responsive">
                            <h3>1. NEW VEHICLE SALES</h3>
                            <div id="chart-vehicle-sales" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">RESULT</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.salesResult } %}
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <h3>NEW VEHICLE SALES GUIDE</h3>
                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td>Sales Member</td>
                                <td>Retail</td>
                                <td>Fleet</td>
                            </tr>
                            <tr>
                                <td>Retail Sales Consultant </td>
                                <td align="center">80</td>
                                <td align="center">80</td>
                            </tr>
                            <tr class="active">
                                <td>Fleet Sales Executive </td>
                                <td align="center">40</td>
                                <td align="center">80</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="row graph-back pl-10">
                    <div class="col-md-7">
                        <div class="table-responsive">
                            <h3>2. Salesperson Satisfaction NPS Rolling Score 6 month Rolling</h3>
                            <div id="chart-recommendation" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">RESULT</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.salesRecommendationResult } %}
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <h3>Salesperson Satisfaction NPS Rolling Score 6 month Rolling Guide</h3>

                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td>Sales Member</td>
                                <td>84%-87.9%</td>
                                <td>≥88%</td>
                            </tr>
                            <tr>
                                <td>Retail Sales Consultant </td>
                                <td align="center">50%</td>
                                <td align="center">100%</td>
                            </tr>
                            <tr class="active">
                                <td>Fleet Sales Executive </td>
                                <td align="center">50%</td>
                                <td align="center">100%</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="row graph-back pl-10">
                    <div class="col-md-7">
                        <h3>3. Follow up 3 month rolling score (Overall satisfaction NPS)</h3>
                        <div class="table-responsive">
                            <div id="chart-followup" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">RESULT</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.followUpCredits } %}
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <h3>Follow up 3 month rolling score (Overall satisfaction NPS) Guide</h3>
                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td>Sales Member</td>
                                <td>100%</td>
                            </tr>
                            <tr>
                                <td>Retail Sales Consultant </td>
                                <td align="center">60</td>
                            </tr>
                            <tr class="active">
                                <td>Fleet Sales Manager / Fleet Sales   Consultant </td>
                                <td align="center">60</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="row graph-back pl-10">
                    <div class="col-md-7">
                        <h3>4. TRAINING</h3>
                        <div class="table-responsive">
                            <div id="chart-training" class="metrics-chart-wrap"></div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <h3>TRAINING GUIDE - RETAIL SALES CONSULTANT</h3>
                        <table class="table small-table" >
                            <tr class="table-top-row">
                                <td>Competency Modules</td>
                                <td>Credits Quartlerly</td>
                            </tr>
                            <tr class="active">
                                <td>Certified Sales Consultant (O)</td>
                                <td>250</td>
                            </tr>
                            <tr class="active">
                                <td>Certified Sales Executive (F)</td>
                                <td>375</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}