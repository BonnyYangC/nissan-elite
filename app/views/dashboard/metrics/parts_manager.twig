{% extends 'layout/frontend.twig' %}
{% block content %}
    <script>
        var CHART_DATA = [
            {
                el: 'chart-grp',
                max: 2300,
                length: 10,
                step: 230,
                colors: ['#c40030'],
                dataSource: {{ json_encode(metrics.GRP)|raw }}
            },
            {
                el: 'chart-gas',
                max: 1100,
                length: 5,
                step: 220,
                colors: ['#999999'],
                dataSource: {{ json_encode(metrics.GAS)|raw }}
            },
            {
                el: 'chart-training',
                max: 3000,
                length: 6,
                step: 500,
                colors: ['#111111', '#555555','#3273dc'],
                pilot: ['Month','Online','Pathway','Competency'],
                isStacked: true,
                dataSource: {{ json_encode(metrics.TRAINING)|raw }}
            },
        ];
    </script>
    <div class="container bg-white">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="page-header">MY Metrics - <em>Parts Manager</em></h1>
            </div>
        </div>
        <div class="row pb-20 pl-10">
            <div class="col-md-12 col-sm-12">
                <div class="row graph-back-top">
                    <div class="col-md-7">
                        <h3>1. Nissan Genuine replacement Parts</h3>
                        <div class="table-responsive">
                            <div id="chart-grp" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">RESULT</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.GRP_RESULTS } %}
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <h3>Nissan Genuine Replacement Parts<strong> </strong>Guide</h3>
                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td>Parts Manager</td>
                                <td align="center">100%</td>
                                <td align="center">110%</td>
                                <td align="center">120%+</td>
                            </tr>
                            <tr>
                                <td>Category A, B, C</td>
                                <td align="center">600</td>
                                <td align="center">1,300</td>
                                <td align="center">2,300</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="row graph-back">
                    <div class="col-md-7" >
                        <div class="table-responsive">
                            <h3>2. Nissan Genuine Accessories</h3>
                            <div id="chart-gas" class="metrics-chart-wrap"></div>
                            <table class="table table-condensed metrics-table-wrap">
                                {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                                <tr>
                                    <td class="nissangray-light-back">RESULT</td>
                                    {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.GAS_RESULTS } %}
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <h3>Nissan Genuine Accessories GUIDE</h3>
                        <table class="table small-table">
                            <tr class="table-top-row">
                                <td>Parts Manager</td>
                                <td align="center">100%</td>
                                <td align="center">110%</td>
                                <td align="center">120%+</td>
                            </tr>
                            <tr>
                                <td>Category A, B, C</td>
                                <td align="center">400</td>
                                <td align="center">700</td>
                                <td align="center">1,100</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="row graph-back">
                    <div class="col-md-7">
                        <h3>3. TRAINING</h3>
                        <div class="table-responsive">
                            <div id="chart-training" class="metrics-chart-wrap"></div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <h3>TRAINING GUIDE</h3>
                        <table class="table small-table" >
                            <tr class="table-top-row">
                                <td>Competency Modules</td>
                                <td>Credits</td>
                            </tr>
                            <tr class="active">
                                <td>Certified Service Advisor</td>
                                <td>500</td>
                            </tr>
                            <tr class="active">
                                <td>Certified Aftersales Manager</td>
                                <td>150</td>
                            </tr>
                            <tr class="active">
                                <td>Business Planning</td>
                                <td>750</td>
                            </tr>
                            <tr class="active">
                                <td>Bonus</td>
                                <td>2000</td>
                            </tr>
                        </table>
                        <p>
                            <em>Refer to the <a href="{{ url('dashboard/MembersGuide') }}">AC18 Member Guide</a> for full details.</em>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}