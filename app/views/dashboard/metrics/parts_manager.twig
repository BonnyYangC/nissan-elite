            {//1. Nissan Genuine replacement Parts
                el: 'chart-grp',
                max: 600,
                length: 4,
                step: 150,
                colors: ['#c40030'],
                pilot: ['Month', yAxis],
                dataSource: {{ json_encode(metrics.GRP)|raw }}
            },
            {//2. Nissan Genuine Accessories
                el: 'chart-gas',
                max: 500,
                length: 10,
                step: 50,
                colors: ['#999999'],
