                el: 'chart-apnur',
                max: 550,
                length: 5,
                step: 110,
                colors: ['#111111', '#c40030' ,'#555555','#3273dc'],
                isStacked: false,
                pilot: ['Month','NAVARA','XTRAIL','QASHQAI'],
                dataSource: {{ json_encode(metrics.APNUR)|raw }}
            },            
            {//4. Brake and Wiper Parts Sales per CPRO
                el: 'chart_brake_wiper_sales',
