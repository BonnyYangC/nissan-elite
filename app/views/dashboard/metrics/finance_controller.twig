{% extends 'dashboard/metrics.twig' %}
{% block content_metrics %}
<script>
    var TRAINING = [{{ metrics.TRAINING|raw }}];

    var CHART_DATA = [
        {//1. Dealer Financial Reporting
            el: 'chart-financial',
            max: 200,
            length: 5,
            step: 40,
            colors: ['#999999','#555555','#c40030'],
            pilot: ['Month', 'Frequency'],
            legend: 'none',
            dataSource: {{ json_encode(metrics.FINANCIAL)|raw }}
        },
        {//2. Quality Of Data Submitted
            el: 'chart-quality',
            max: 1025,
            length: 10,
            step: 205,
            colors: ['#999999','#555555','#c40030'],
            pilot: ['Month', 'Balance', 'Submission'],
            legend: 'none',
            dataSource: {{ json_encode(metrics.QUALITY)|raw }}
        },
        {//3. Nissan Business Management
            el: 'chart-MANAGEMENT',
            max: 700,
            length: 6,
            step: 350,
            colors: ['#999999', '#555555' ,'#c40030'],
            pilot: ['Month','Checklist', 'Attendance'],
            dataSource: {{ json_encode(metrics.MANAGEMENT)|raw }}
        },
        {//4. Training
            el: 'chart-training',
            duration: 2000,
            pilot: ['Month', 'Online', 'Pathway','Competency'],
            max: 1000,
            length: 10,
            step: 100,
            colors: ['#111111','#c40030','#3273dc'],
            isStacked: true,
            dataSource: {{ json_encode(metrics.TRAINING)|raw }}
        }
    ];
</script>

    <div class="row pb-20 pl-10">
        <div class="col-md-12 col-sm-12">
            <div class="row graph-back-top">
                <div class="col-md-7">
                    <h3>1. Dealer Financial Reporting</h3>
                    <div class="table-responsive">
                        <div id="chart-financial" class="metrics-chart-wrap"></div>
                        <table class="table table-condensed metrics-table-wrap">
                            {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                            <tr>
                                <td class="nissangray-light-back sm" style="padding-left: 0;padding-right:0;">FREQUENCY</td>
                                {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.FREQUENCY_RESULTS } %}
                            </tr>
                       </table>
                    </div>
                </div>
                <div class="col-md-5">
                    <h3>Dealer Financial Reporting Guide</h3>
                    <table class="table small-table">
                        <tr class="table-top-row">
                            <td>Financial Controller</td>
                            <td align="center">Submitted<br>
                                Frequency</td>
                        </tr>
                        <tr class="active">
                            <td>Category A, B, C</td>
                            <td align="center">200</td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row graph-back">
                <div class="col-md-7">
                    <h3>2. Quality Of Data Submitted</h3>
                    <div class="table-responsive">
                        <div id="chart-quality" class="metrics-chart-wrap"></div>
                        <table class="table table-condensed metrics-table-wrap">
                            {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                            <tr>
                                <td class="nissangray-light-back sm" style="padding-left: 0;padding-right:0;">SUBMISSION</td>
                                {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.SUBMISSION_RESULTS,'extraClass':'pt-9' } %}
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="col-md-5">                       
                    <h3>Quality of Data GUIDE - Date of Submission</h3>
                    <div class="table-responsive">
                        <table class="table small-table table-condensed">
                            <tr class="table-top-row">
                                <td>Financial Controller</td>
                                <td align="center">&lt;10</td>
                                <td align="center">10</td>
                                <td align="center">11</td>
                                <td align="center">12</td>
                                <td align="center">13</td>
                                <td align="center">14</td>
                                <td align="center">15</td>
                                <td align="center">16</td>
                                <td align="center">17</td>
                                <td align="center">18</td>
                                <td align="center">19</td>
                                <td align="center">20</td>
                                <td align="center">21</td>
                            </tr>
                            <tr class="active">
                                <td>Category A, B, C</td>
                                <td align="center">1025</td>
                                <td align="center">1000</td>
                                <td align="center">950</td>
                                <td align="center">900</td>
                                <td align="center">850</td>
                                <td align="center">800</td>
                                <td align="center">750</td>                                
                                <td align="center">500</td>
                                <td align="center">450</td>
                                <td align="center">400</td>
                                <td align="center">300</td>
                                <td align="center">250</td>
                                <td align="center">200</td>
                            </tr>
                        </table>
                    </div>
                    <p>
                        <br>
                        <em>Note:  As of 1st July 2019 – this report must be at Submission Status in Nissan BMO on or before COB 18th of each month, or first working day following if 18th falls on a weekend</em>
                    </p>
                </div>
            </div>
            <div class="row graph-back">
                <div class="col-md-7">
                    <h3>3. Nissan Business Management</h3>
                    <div class="table-responsive">
                        <div id="chart-MANAGEMENT" class="metrics-chart-wrap"></div>
                        <table class="table table-condensed metrics-table-wrap">
                            {% include 'dashboard/metrics/elements/common/months_table_title.twig' %}
                            <tr>
                                <td class="nissangray-light-back sm" style="padding-right:0;">CHECKLIST</td>
                                {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.CHECKLIST_RESULTS } %}
                            </tr>
                            <tr>
                                <td class="nissangray-light-back sm" style="padding-right:0;">ATTENDED</td>
                                {% include 'dashboard/metrics/elements/common/result_table_elements.twig' with {'tdElements':metrics.MEETING_RESULTS } %}
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="col-md-5">
                    <h3>Nissan Business Management GUIDE</h3>
                    <table class="table small-table">
                        <tr class="table-top-row">
                            <td>Financial Controller</td>
                            <td align="center">
                                Data Accuracy <br>checklist
                            </td>
                            <td align="center">
                                BDG Attendance Each<br>                                    
                            </td>
                        </tr>
                        <tr class="active">
                            <td>Category A, B, C</td>
                            <td align="center">550</td>
                            <td align="center">700</td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row graph-back">
                <div class="col-md-7">
                    <h3>4. Training </h3>
                    <div class="table-responsive">
                        <div id="chart-training" class="metrics-chart-wrap"></div>
                    </div>
                </div>
                <div class="col-md-5">
                    <h3>TRAINING GUIDE</h3>
                    <table class="table small-table" >
                        <tr class="table-top-row">
                            <td>Competency Modules</td>
                            <td>Points</td>
                        </tr>
                        <tr class="active">
                            <td>Financial Controller Pathway (O)</td>
                            <td>450</td>
                        </tr>
                    </table>
                    <p>
                        <em>Refer to the <a href="{{ url('dashboard/MembersGuide') }}">{{ configuration('PROGRAM_SHORT_NAME_WITH_YEAR') }} Member Guide</a> for full details.</em>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
