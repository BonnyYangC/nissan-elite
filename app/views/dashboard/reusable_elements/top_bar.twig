<div class="row">
    <div class="col-xs-1 col-sm-1 col-md-1 pl-0">
        <a class="navbar-brand" href="{{ dashboardMenuOnly ? '#' : url('/elite_individual') }}" >
            <img src="{{ asset('/images/loader/Nissan_Tablet.png') }}" alt="Elite Individaul" height="150px"/>
        </a>
    </div>
    <div class="col-xs-5 col-sm-5 col-md-5 pl-45">
            <a class="navbar-brand" href="{{ dashboardMenuOnly ? '#' : url('/elite_individual') }}" >
                <img src="{{ asset('/images/loader/ELITE-individual-white.png') }}" alt="Elite Individaul" height="184px"/>
            </a>
        </div>
    <div class="col-xs-12 col-sm-12 col-md-6 pr-0" style="{{ isTablet ? 'padding-right: 70px;' : null }}">
        <p class="loggedin">
            {% if fromApi %}
                <span>
                    <a href="#" onclick="window.close();return false;">BACK TO DEALER EXCELLENCE</a>
                </span>
            {% elseif dashboardMenuOnly %}
                <span>
                    <a href="#" onclick="window.close();return false;">CLOSE</a>
                </span>
            {% else %}
                <span>{{ user.getName() }}</span>
                <span class="color-dark-grey">{{ user.getCompany().company_name }}</span>
                {% if not isPhone %}
                <span>
                    <a href="{{ url('/elite_individual') }}">HOME</a>
                </span>
                {% endif %}
                <span>
                    <a href="{{ url('/user/logout') }}">LOGOUT</a>
                </span>
            {% endif %}
        </p>
    </div>
</div>