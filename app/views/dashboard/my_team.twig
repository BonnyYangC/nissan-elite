{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container bg-white pl-25 pr-25">
        <div class="ac-tooltip">1000</div>
        <div class="row">
            <div class="col-md-9">
                <h1 class="page-header" >
                    <span class='page-header-title'>Welcome {{ user.firstname }} - {{ currentRoleText }}</span>
                </h1>
            </div>
        </div>
        <!-- Projects Row -->
        <div class="row pb-20">
            <div class="col-md-12">
                {% if count(user.teamMembers) > 0 %}
                    <div class="col-md-12">
                        <h3>
                            My Team Member{{ count(user.teamMembers)>1 ? 's':null }}
                        </h3>
                        {% include 'dashboard/widget_element/users_table.twig' %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}