{% extends 'layout/frontend.twig' %}
{% block content %}
    <style>
        table {
            background-color: transparent !important;
        }

        th.month-title {
            color: #c40030;
            font-size: 24px !important;
            font-weight: bold;
        }
        th.day-header {
            background-color: #c40030;
            color: #FFFFFF;
            padding-top: 5px !important;
            padding-bottom: 5px !important;
        }
        .calendar {
            overflow-y: hidden;
        }

        .calendar .month-container {
            min-width: 180px;
            text-align: center;
            height: 250px;
            padding: 0;
        }

        .calendar .month-container.selected {
            background-color: #FFF5F7;
        }

        table.month.highlighted td {
            background-color: #FFD9E2;
            color: #c40030;
        }
    </style>
    <script>
        {#var calendarEvents = {{ eventsJsObjectString|raw }};#}
        var calendarEvents = [
            {% for event in nissanEvents %}
            {
                id:{{ event.id }},
                name: "{{ event.title }}",
                startDate: new Date("{{ event.datestamp }}"),
                endDate: new Date("{{ event.dateend }}")
            },
            {% endfor %}
        ];
    </script>
    <div class="container bg-white">
        <div class="row">
            {#{% include 'dashboard/widget_element/calendar/month.twig' %}#}
        </div>
        <div class="row">
            <div class="col-lg-12">
                <h1 class="page-header">
                    <span class='page-header-title'>{{ constant('ProgramShortName') }} CALENDAR</span>
                </h1>
            </div>
        </div>
        <div class="row pb-20">
            <div id="calendar" class="col-md-12"></div>
        </div>
    </div>
{% endblock %}