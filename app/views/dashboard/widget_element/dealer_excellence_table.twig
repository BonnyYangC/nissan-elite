<div class="table-responsive">
    <table class="table centre-text">
        <tr class="nissangray-back">
            <td colspan="2">{{ configuration('PROGRAM_DEALERSHIP') }}</td>
        </tr>
        <tr class="nissangray-light-back">
            <td>
                <span class="rank span-red">
                    {% if user.excellence_eligible %}
                        &#10004;
                    {% else %}
                        X
                    {% endif %}
                </span>
                {% if user.excellence_eligible %}
                    <p class="tw">2000 {{ configuration('PROGRAM_AWARD_UNIT')|lower }} Applied</p>
                {% else %}
                    <p class="tw">
                        Refer <a target="_blank" href="{{ env('dealExcellenceOverviewUrl', '') }}">{{ configuration('PROGRAM_DEALERSHIP') }}</a> overview
                    </p>
                {% endif %}
            </td>
        </tr>
    </table>
</div>