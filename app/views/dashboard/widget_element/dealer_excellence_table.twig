<div class="table-responsive">
    <table class="table centre-text">
        <tr class="nissangray-back">
            <td colspan="2">{{ configuration('PROGRAM_DEALERSHIP') }}</td>
        </tr>
        <tr class="nissangray-light-back">
            <td>
                <span class="rank span-red">
                    {% if user.excellence_eligible %}
                        &#10004;
                    {% else %}
                        X
                    {% endif %}
                </span>

                {% if user.excellence_eligible %}
                    <p class="tw">2000 {{ configuration('PROGRAM_AWARD_UNIT')|lower }} applied to Monthly points</p>
                {% endif %}


                <p class="tw">
                    {% if not dashboardMenuOnly %}
                        {% if user.position == 'M' %}
                            {% set param = '/api?role=' ~ user.position ~ '&code=' ~ user.company_code %}
                        {% else %}
                            {% set param = '/api?role=AP'%}
                        {% endif %}
                        <a href="#" onclick="window.open('{{ env('dealExcellenceOverviewUrl') ~ param }}')">View FY20 Rankings</a>
                    {% endif %}
                </p>
            </td>
        </tr>
    </table>
</div>
