<div class="table-responsive">
    <table class="table centre-text">
        <tr class="nissangray-back">
            <td colspan="2">{{ configuration('PROGRAM_DEALERSHIP') }}</td>
        </tr>
        <tr class="nissangray-light-back">
            <td>
                <span class="rank span-red">
                    {% if user.excellence_eligible %}
                        &#10004;
                    {% else %}
                        X
                    {% endif %}
                </span>

                {% if user.excellence_eligible %}
                    <p class="tw">2000 {{ configuration('PROGRAM_AWARD_UNIT')|lower }} Applied</p>
                {% else %}
                    <p class="tw">
                        {% if dashboardMenuOnly %}
                            Refer <span class='span-red'>{{ configuration('PROGRAM_DEALERSHIP') }}</span>
                        {% else %}
                            {% if user.position == 'M' %}
                            {% set param = '/api?role=' ~ user.position ~ '&code=' ~ user.company_code %}
                            {% else %}
                            {% set param = '/api?role=AP'%}
                            {% endif %}
                            Refer <a target="_blank" href="{{ env('dealExcellenceOverviewUrl') ~ param }}">{{ configuration('PROGRAM_DEALERSHIP') }}</a>
                        {% endif %}
                    </p>
                {% endif %}
            </td>
        </tr>
    </table>
</div>