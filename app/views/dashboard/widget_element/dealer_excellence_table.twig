<div class="table-responsive">
    <table class="table centre-text">
        <tr class="nissangray-back">
            <td colspan="2">{{ constant('ProgramDealership') }}</td>
        </tr>
        <tr class="nissangray-light-back">
            <td>
                <span class="rank span-red">
                    {% if dashboard.excellence > 0 %}
                        &#10004;
                    {% else %}
                        X
                    {% endif %}
                </span>
                {% if dashboard.excellence %}
                    <p class="tw">{{ number_format(dashboard.excellence) }} {{ env('PROGRAM_AWARD_UNIT')|lower }} Applied</p>
                {% else %}
                    <p class="tw">
                        Refer <a target="_blank" href="{{ env('dealExcellenceOverviewUrl') }}">{{ constant('ProgramDealership') }}</a> overview
                    </p>
                {% endif %}
            </td>
        </tr>
    </table>
</div>