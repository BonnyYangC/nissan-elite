<div class="table-responsive">
    <table class="table centre-text">
        <tr class="nissangray-back">
            <td colspan="2">{{ configuration('PROGRAM_DEALERSHIP') }}</td>
        </tr>
        <tr class="nissangray-light-back">
            <td>
                <span class="rank span-red">
                    {% if dashboard.excellence > 0 %}
                        &#10004;
                    {% else %}
                        X
                    {% endif %}
                </span>
                {% if dashboard.excellence > 0 %}
                    <p class="tw">{{ number_format(dashboard.excellence) }} {{ configuration('PROGRAM_AWARD_UNIT')|lower }} Applied</p>
                {% else %}
                    <p class="tw">
                        Refer <a target="_blank" href="{{ env('dealExcellenceOverviewUrl') ~ '/api/welcome?api_token=' ~ env('DEALER_EXCELLENCE_API_TOKEN') }}">{{ configuration('PROGRAM_DEALERSHIP') }}</a> overview
                    </p>
                {% endif %}
            </td>
        </tr>
    </table>
</div>