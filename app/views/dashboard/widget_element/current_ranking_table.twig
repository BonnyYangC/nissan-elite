<div class="table-responsive">
    <table class="table centre-text">
        <tr class="nissangray-back">
            <td colspan="2">Your Current Ranking</td>
        </tr>
        <tr class="nissangray-light-back">
            <td>
                <span class="rank">{{ dashboard.rankingNationally ? ordinal(dashboard.rankingNationally) : 'N/A' }}</span><br>
                <p>Nationally</p>
            </td>

            {% if dashboard.rankingRegionally %}
                <td>
                    <span class="rank">{{ ordinal(dashboard.rankingRegionally) }}</span><br>
                    <p>Regionally</p>
                </td>
            {% endif %}
        </tr>
    </table>
</div>