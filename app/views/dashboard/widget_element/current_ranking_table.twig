<div class="table-responsive">
    <table class="table centre-text">
        <tr class="nissangray-back">
            <td colspan="2">Your Current Ranking</td>
        </tr>
        <tr class="nissangray-light-back">
            <td>
                <span class="rank">{{ statusRanking ? ordinal(statusRanking) : 'N/A' }}</span><br>
                <p>STATUS</p>
            </td>
            {% if platinumRanking %}
                <td>
                    <span class="rank">{{ platinumRanking ? ordinal(platinumRanking) : 'N/A' }}</span><br>
                    <p>PLATINUM</p>
                </td>
            {% endif %}
        </tr>
    </table>
</div>