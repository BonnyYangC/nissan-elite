<div style="padding: 10px 0;">
    <strong>You have had multiple roles: </strong>
    <select id="metricsRoleSelect">
        {% for database_table_name,label in userPositions %}
        <option value="{{ database_table_name }}" {{ targetDatabaseTableName==database_table_name ? 'selected' : null }}>{{ label }}</option>
        {% endfor %}
    </select>
</div>
<script>
    var metricsRoleSelect = document.getElementById('metricsRoleSelect');
    if (metricsRoleSelect) {
        metricsRoleSelect.addEventListener('change', function (e) {
            window.location.href = '/dashboard?asRole=' + e.target.value;
        });
    }
</script>
{% include 'dashboard/widget_element/credits_earned/single_role.twig' %}