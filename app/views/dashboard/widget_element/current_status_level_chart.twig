<div class="table-responsive">

    <img src="/dashboard/current-status-level?complete={{ dashboard.ytd }}&position={{ user.position }}&id={{ user.user_id }}" height=300 width=700 />

    <p align="center">
        <b><span style="color:#ff0000;margin-top:20px;">{{ dashboard.statusChart.toReach }}</span> {{ dashboard.statusChart.colorText }}</b>
    </p>

    <hr>

    <h3>Dollar Rewards and Credits</h3>
    <div class="table-responsive" >
        <table class="table" >
            <tr class="table-top-row">
                <td align="center">Consul</td>
                <td align="center">Diplomat</td>
                <td align="center">Ambassador</td>
                <td align="center">Premier</td>
            </tr>
            <tr>
                {% set dollorDataRanges = dashboard.rewardsDollars[0] %}
                {% for val in dollorDataRanges %}
                    <td align="center">${{ val }}</td>
                {% endfor %}
            </tr>
            <tr class="active">
                {% set dollorDataRanges = dashboard.rewardsDollars[1] %}
                {% for val in dollorDataRanges %}
                    <td align="center" class="rewardsLevels">{{ val }}</td>
                {% endfor %}
            </tr>
        </table>
    </div>
</div>
