<div class="table-responsive">

    <img src="/dashboard/current-status-level?complete={{ dashboard.ytd }}&position={{ user.position }}&id={{ user.user_id }}" height=300 width=700 />

    <p align="center">
        <b><span style="color:#ff0000;margin-top:20px;">{{ dashboard.statusChart.toReach }}</span> {{ dashboard.statusChart.colorText }}</b>
    </p>

    <hr>

    <h3>Dollar Rewards and {{ configuration('PROGRAM_AWARD_UNIT')|raw }} <span class="no-transform">(achieve your criteria to be rewarded)</span></h3>
    <div class="table-responsive" >
        <table class="table" >
            <tr class="table-top-row">
                <td align="center">{{ dashboard.statusChart.gageArray[0][2]|upper }}</td>
                <td align="center">{{ dashboard.statusChart.gageArray[1][2]|upper }}</td>
                <td align="center">{{ dashboard.statusChart.gageArray[2][2]|upper }}</td>
                <td align="center">{{ dashboard.statusChart.gageArray[3][2]|upper }}</td>
            </tr>
            <tr>
                {% set dollorDataRanges = dashboard.rewardsDollars[0] %}
                {% for val in dollorDataRanges %}
                    <td align="center">${{ val }}</td>
                {% endfor %}
            </tr>
            <tr class="active">
                {% set dollorDataRanges = dashboard.rewardsDollars[1] %}
                {% for val in dollorDataRanges %}
                    <td align="center" class="rewardsLevels">{{ val }}</td>
                {% endfor %}
            </tr>
        </table>
    </div>
</div>
<style>
    h3 .no-transform{
        font-size : 16px;
        text-transform: lowercase;
    }
</style>
