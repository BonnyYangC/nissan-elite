<div class="table-responsive">
    <table class="table centre-text">
        <tr class="nissangray-back">
            <td colspan="2">Have you met criteria?</td>
        </tr>
        <tr class="nissangray-light-back">
            <td>
                    {% if user.met_criteria %}
                        <span class="rank span-red">
                            &#10004;
                        </span>
                    {% else %}
                        <p class="tw">
                            Compulsory at 31 March {{ configuration('YEAR')+1 }}
                            <br>Refer <a target="_blank" href="/dashboard/MembersGuide">Member Guide</a>
                        </p>
                    {% endif %}
                <br>
            </td>
        </tr>
    </table>
</div>