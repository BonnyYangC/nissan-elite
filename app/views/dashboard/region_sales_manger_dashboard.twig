{% extends 'layout/frontend_full_width.twig' %}
{% block content %}
    <script>
        var managerId = {{ user.user_id }};
        var employeeCode = "{{ user.employee_code }}";
        var regions = {{ json_encode(regions) | raw }};
    </script>
    <style>
        .el-table .sort-caret.ascending{
            border-bottom-color: #fff;
        }
        .el-table .sort-caret.descending{
            border-top-color: #fff;
        }
    </style>
    <div class="container-fluid bg-white {{ isPhone?null:'ml-20 mr-20' }}" id="dsm-app">
        <div class="row">
            <div class="col-md-4 col-xs-12">
                <h1 class="{{ isPhone?'text-center':'pull-left' }}" >
                    <span style="font-size:20px; padding-top:0;">Territory Report {{ configuration('YEAR') }}</span>
                </h1>
            </div>
            <div class="col-md-8 col-xs-12">
                <p class="mt-20 {{ isPhone?'text-center':'text-right' }}" style="padding-top:12px;">
                    {% set yearShort = configuration('YEAR')-2000 %}
                    <a href="http://learning.nissan.com.au" class="btn btn-default" target="_blank" style="background-color: #cccccc;">
                        <i class="fa fa-arrow-circle-o-right"></i>&nbsp;Nissan Academy</a>&nbsp;
                    <a href="{{ url('/admin/jump_to_dealer') }}" class="btn btn-danger">
                        <i class="fa fa-arrow-circle-o-right"></i>&nbsp;Nissan Dealer Excellence</a>&nbsp;
                    <a href="#" v-on:click="handlerTerritoryReport($event,{{ user.user_id }})" class="btn btn-default">
                        <i class="fa fa-download"></i>&nbsp;{{ isPhone?null:'Download' }} Territory Report</a>&nbsp;
                    <a href="#" v-on:click="handlerActiveMemberList($event,{{ user.user_id }})" class="btn btn-default">
                        <i class="fa fa-download"></i>&nbsp;{{ isPhone?null:'Download' }} Active Member List</a>
                </p>
            </div>
        </div>
        <hr>
        <div class="row pb-20">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-6">
                        <p>
                            <el-input
                                    placeholder="Find a Dealer ..."
                                    v-model="keyword"
                                    clearable>
                            </el-input>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p>
                            <el-select v-model="dept" placeholder="Department" v-on:change="showOnly">
                                <el-option
                                        v-for="(item, idx) in departments"
                                        :key="idx"
                                        :label="item.label"
                                        :value="item.value">
                                </el-option>
                            </el-select>
                        </p>
                    </div>
                </div>

                <div class="row mt-20 mb-20" v-show="isLoadingRemoteData">
                    <div class="col-md-12">
                        <i class="fa fa-cog fa-spin fa-3x fa-fw margin-bottom txt-red"></i>&nbsp;<span class="txt-red">Loading Data ... Please wait for a moment!</span>
                    </div>
                </div>

                <el-table
                        v-show="tableData.length>0"
                        :data="tableData"
                        border
                        height="800"
                        header-row-class-name="dsm-table-header"
                        empty-text="Loading data ..."
                        :row-class-name="showMe"
                        style="width: 100%">
                    <el-table-column prop="d" fixed sortable label="Dealer" width="160">
                        <template slot-scope="scope">
                            ${ scope.row.d }
                        </template>
                    </el-table-column>
                    <el-table-column
                            prop="f" {{ isPhone?null:'fixed' }} sortable
                            label="Name" width="180">
                        <template slot-scope="scope">
                            <a class="txt-black" :href="getMockUserUrl(scope.row.e)" target="_blank">${ scope.row.f }</a>
                        </template>
                    </el-table-column>
                    <el-table-column
                            prop="c" {{ isPhone?null:'fixed' }} sortable
                            label="Registered" width="140">
                        <template slot-scope="scope">
                            <p class="text-center" :class="{'txt-gr':scope.row.c=='YES','txt-red':scope.row.c=='NO'}">
                                ${ scope.row.c }
                            </p>
                        </template>
                    </el-table-column>
                    <el-table-column
                            prop="s" {{ isPhone?null:'fixed' }}
                            label="Dept" sortable width="96">
                        <template slot-scope="scope">
                            ${ scope.row.s === 'Administration' ? 'Admin' : scope.row.s }
                        </template>
                    </el-table-column>
                    <el-table-column
                            prop="p" {{ isPhone?null:'fixed' }}
                            label="Position" sortable width="200">
                        <template slot-scope="scope">
                            ${ getFullPositionNameByCode(scope.row.p) }
                        </template>
                    </el-table-column>
                    <el-table-column
                            prop="y" {{ isPhone?null:'fixed' }}
                            label="YTD" sortable width="100">
                    </el-table-column>
                    <el-table-column
                            prop="c04"
                            label="Apr" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c05"
                            label="May" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c06"
                            label="Jun" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c07"
                            label="Jul" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c08"
                            label="Aug" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c09"
                            label="Sep" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c10"
                            label="Oct" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c11"
                            label="Nov" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c12"
                            label="Dec" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c01"
                            label="Jan" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c02"
                            label="Feb" sortable width="86">
                    </el-table-column>
                    <el-table-column
                            prop="c03"
                            label="Mar" sortable width="86">
                    </el-table-column>
                </el-table>
            </div>
        </div>
    </div>
{% endblock %}