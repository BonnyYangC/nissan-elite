{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container bg-white pl-25 pr-25">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="page-header" >
                    Loyalty {{ configuration('PROGRAM_AWARD_UNIT')|raw }}
                </h1>
            </div>
        </div>
        <!-- Projects Row -->
        <div class="row pb-20">
            <div class="col-md-9">
                <div class="table-responsive">
                    <h3 class="pl-10">Current STATUS LEVEL</h3>
                    {% include 'dashboard/widget_element/lifetime_status_level_chart.twig' %}
                </div>

                <h3 style="color:black">Loyalty to the brand: {{ number_format(loyalty_to_brand, 0) }} </h3>

                {% for year,amount in display_years %}
                    <h3 style="color:black">FY{{ year }} : {{ number_format(amount, 0) }} </h3>
                {% endfor %}

                <h3 style="color:black">FY{{ this_year_two_digit }} YTD : {{ number_format(dashboard.ytd, 0) }} </h3>

            </div>
            <div class="col-md-3 pb-0">
            
                {% include 'dashboard/widget_element/life_time_table.twig' %}
                
                <table class="table centre-text">
                    <tr class="table-top-row"><td colspan=2>Legend</td></tr>
                    <tr><td style="background: #8C7853;">Bronze</td><td>100,000</td></tr> <!--need to update to use LifetimeUtil:: const TBD-->
                    <tr><td style="background: #C0C0C0;">Silver</td><td>200,000</td></tr>
                    <tr><td style="background: #CD7F32;">Gold</td><td>325,000</td></tr>
                    <tr><td style="background: #545454; color: #ffffff;">Platinum</td><td>500,000</td></tr>
                </table>
            </div>
        </div>
    </div>    
{% endblock %}