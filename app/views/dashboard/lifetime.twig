{% extends 'layout/frontend.twig' %}
{% block content %}
    <div class="container bg-white pl-25 pr-25">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="page-header" >
                    <span style="font-size:20px; padding-top:0;">
                        MY DASHBOARD
                    </span>
                    <br>
                    Lifetime credits
                </h1>
            </div>
        </div>
        <!-- Projects Row -->
        <div class="row pb-20">
            <div class="col-md-9">
                <div class="table-responsive">
                    <h3 class="pl-10">Current STATUS LEVEL</h3>
                    {% include 'dashboard/widget_element/lifetime_status_level_chart.twig' %}
                </div>
                <hr>
                <div class="row">
                    <div class="col-md-12">
                        <h3 class="mb-20">
                            1992 - Current
                        </h3>
                        <script>
                            var HISTORY = {{ json_encode(dashboard.history)|raw }};
                        </script>
                        <div id="barchart_material" class="mb-60" style="width: 100%; height: 800px;"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 pb-0">
                {% include 'dashboard/widget_element/life_time_table.twig' %}
                <table class="table centre-text">
                    <tr class="table-top-row"><td colspan=2>Legend</td></tr>
                    <tr><td style="background: #8C7853;">Bronze</td><td>100,000</td></tr>
                    <tr><td style="background: #C0C0C0;">Silver</td><td>200,000</td></tr>
                    <tr><td style="background: #CD7F32;">Gold</td><td>325,000</td></tr>
                    <tr><td style="background: #545454; color: #ffffff;">Platinum</td><td>500,000</td></tr>
                </table>
                <a href="{{ url('/dashboard') }}" >
                    <button type="button" style="margin:50px 0; background:#c40030; background-image: linear-gradient(0deg, #76001d, #c40030); color:#ffffff; text-transform: uppercase; " class="btn btn-default btn-lg btn-block">Back to Dashboard</button>
                </a>
            </div>
        </div>
    </div>
{% endblock %}