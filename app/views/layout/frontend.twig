<!DOCTYPE html>
<html>
{{ include('layout/reusable_elements/head.twig') }}
<body class="bg-black">
    {# Load the navigator from the reuseable element of dashboard #}
    {% if isPhone and env('MOBILE_VERSION','TW')=='APP STYLE' %}
        {% include 'dashboard/reusable_elements/nav_mobile.twig' %}
    {% else %}
        {# Load the top bar from the reuseable element of dashboard #}
    <div class="container" id="banner">
        {% include 'dashboard/reusable_elements/top_bar.twig' %}
        {% include 'dashboard/reusable_elements/nav.twig' %}
    </div>
    {% endif %}

    <main id="panel" class="panel-mask bg-black">
        {% if isPhone and env('MOBILE_VERSION','TW')=='APP STYLE' %}
            {# If mobile devices #}
            <button class="toggle-button">☰</button>
            {# Load the top bar from the reuseable element of dashboard #}
            {% include 'dashboard/reusable_elements/top_bar.twig' %}
        {% endif %}

        {% block content %}{% endblock %}
        {# Load the footer section from the reuseable element of dashboard #}
        {{ include('dashboard/reusable_elements/footer_nav.twig') }}
    </main>

    {# Load all js script tags from the reuseable element of layout #}
    {{ include('layout/reusable_elements/footer.twig') }}
</body>
</html>