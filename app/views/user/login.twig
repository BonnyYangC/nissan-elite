{% extends 'layout/login.twig' %}
{% block content %}
    <section>
        <ul class="cb-slideshow">
            <li><span></span></li>
            <li><span></span></li>
            <li><span></span></li>
            <li><span></span></li>
            <li><span></span></li>
            <li><span></span></li>
        </ul>
        <div class="container-loop">
            <div class="codrops-top">
                <a href="#"></a>
                <span class="right">
                    </span>
                <div class="clr"></div>
            </div>
            <header>
                <div class="login-form">
                    <form id="login-form" method="post" action="{{ url('user/login') }}" class="form-signin" role="form" >
                        <input type="hidden" name="action" value="login">
                        <div align="center"><img src="{{ asset('images/nissanac-logo-footer.png') }}" width="240px" style="padding-bottom:20px"></div>
                        <input name="email" id="email" type="email" class="form-control" placeholder="Email" autofocus />
                        <input name="password" id="password" type="password" class="form-control" placeholder="Password" />
                        {% if errorMsg %}
                            <p style="text-align: center;color: red;margin-top: -17px;font-size: 15px;font-weight: bold;">{{ errorMsg }}</p>
                        {% endif %}
                        <button class="btn btn-block bt-login">Submit</button>
                    </form>
                    <div class="form-footer">
                        <div class="row">
                            <div class="col-xs-6 col-sm-6 col-md-7">
                                <a class="txt-grey9" href="#forgotpassword" > Forgot password? </a>
                            </div>
                            <div class="col-xs-6 col-sm-6 col-md-5">
                                <a class="txt-grey9" href="#eligible">New to Nissan?</a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
        </div>
    </section>
    <section id="eligible" >
        <div class="container">
            <div style="margin:0 auto; height: 600px; padding-top:200px; text-align: center; font-size:16px; margin-bottom:200px;z-index: 9999;">
                <span style="font-size:50px; color:#FFFFFF;">New to Nissan? </span> <br><br>
                <div class="bs-example">
                    <div class="panel-group" id="accordion">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 class="panel-title">
                                    <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">1. Can I join Nissan ELITE?</a>
                                </h4>
                            </div>
                            <div id="collapseOne" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <p>If you are currently employed by Nissan Australia in one of the following job functions at a Nissan Dealership in Australia, you are automatically invited to register and participate in the program:<br>
                                        • Sales Manager<br>
                                        • Retail Sales Consultant<br>
                                        • Fleet Sales Consultant<br>
                                        • F&I Manager<br>
                                        • Financial Controller<br>
                                        • Service Manager<br>
                                        • Service Advisor<br>
                                        • Stock Controllers<br>
                                        • Parts Manager<br>
                                        • Parts Sales Representative<br>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 class="panel-title">
                                    <a data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">2. How do I register for Nissan ELITE?</a>
                                </h4>
                            </div>
                            <div id="collapseTwo" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <p>Go to <a href="http://www.nissanevents.com.au/nissanelite/reg" target="_blank">www.nissanevents.com.au/nissanelite/reg</a> and successfully complete the 2019 Nissan ELITE Program registration form including a requirement to accept the program terms and conditions as directed. On completion, you will receive a confirmation e-Mail for your Nissan ELITE Program registration.</p>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 class="panel-title">
                                    <a data-toggle="collapse" data-parent="#accordion" href="#collapseThree">3. Further queries?</a>
                                </h4>
                            </div>
                            <div id="collapseThree" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <p>The Nissan ELITE Service Centre can be contacted on:<br><br>
                                        Telephone:  	03 9544 9054<br>
                                        Email: 		info@nissanelite.com.au
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <p style="color:#FFFFFF;" ><strong>Note:</strong> Click on any of the above tabs to see more information. Go back to <a href="#">login</a> </p>
                </div>
            </div>
        </div>
    </section>
    <section>
        <div class="container">
            <div class="row" id="forgotpassword">
                <div class="col-md-6 col-md-offset-3 col-xs-12">
                    <div class="fgp-wrap {{ clientAgent.isPhone() ? 'mt-20' : 'pt-200' }}">
                        <p class="txt-white" style="{{ clientAgent.isPhone() ? 'font-size: 32px;' : null }}">Forgot Password?</p>
                        <p  class="txt-white" style="{{ clientAgent.isPhone() ? 'font-size: 32px;' : null }}">Please enter your registered email address.</p>
                        <input v-model="email" name="Email" id="Email" type="email" class="form-control" placeholder="Email Address">
                        <el-button v-on:click="onSubmit($event)" :loading="inProgress" class="btn btn-block bt-login fgp-submit-btn">Submit</el-button>
                        <p class="txt-white fs-14 mt-10">
                            <strong>Note:</strong> Go back to <a href="#">login</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}