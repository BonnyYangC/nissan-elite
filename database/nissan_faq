INSERT INTO `nissan_faq` VALUES (1,'How and when do I have to register?','<p>Members must register once every program year. 2021 program starts 1 Apr 2021 – 31 March 2022 at <a href=\"https://www.nissanelite.com.au/reg2021\">https://www.nissanelite.com.au/reg2021</a>.</p>',1,1),(2,'How do I join the Nissan ELITE?','<p>Refer to “Are you eligible?” on the login page.   You must be enrolled on the Nissan Dealer User Management portal and hold a 5-digit registration number and be in an Nissan ELITE eligible role.  You will be automatically rolled over into Nissan ELITE, receiving a Welcome Pack with your details, and notification for your compulsory registration at <a href=\"https://www.nissanelite.com.au/reg2021\">https://www.nissanelite.com.au/reg2021</a>. On completion you will receive an e-Mail confirmation and only then be eligible to earn Awards/Rewards within Nissan ELITE. </p>',1,2),(3,'Am I eligible to participate in Sprint Incentives?','<p>Yes, providing the criteria is applicable to your role and all ELITE & Sprint Incentive T&Cs are met.  Nissan ELITE registration is compulsory for all incentives.</p>',1,3),(4,'Am I eligible in Nissan ELITE if I am enrolled on the Nissan Dealer User Management portal?','<p>If you are enrolled on the Nissan Dealer User Management portal in an eligible ELITE role you are a member of ELITE but NOT an eligible member until you have registered in the current program period. Every member must register once in every Nissan ELITE period (current program 1 Apr – 31 March) to be eligible.</p>',1,4),(5,'What is the Nissan ELITE period?','<p>Annual Program from - 1 Apr – 31 March </p>',1,5),(6,'Where can I find my metrics and criteria for Nissan ELITE?','<p>Go to the Members Guide tab and click your department/role tab. You will find all information about Nissan ELITE here.</p>',1,6);
